{"parentUuid":"c765ed03-8e36-4ded-94d5-bf8baa34e44c","isSidechain":true,"agentId":"a348f3ee234ac4fb3","message":{"model":"claude-opus-4-6","id":"msg_011CeZLwS48AngqQ6hxSPgh1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GHJaaEzjqCoxFp5cVKiQTV","name":"Read","input":{"file_path":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/quadrature.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":5852,"cache_read_input_tokens":16388,"cache_creation":{"ephemeral_5m_input_tokens":5852,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null},"requestId":"req_011CeZLwR8oh2PDBWk1Du5P5","attributionAgent":"general-purpose","type":"assistant","uuid":"b3adf6cc-760e-45c2-8a62-d2f76d239368","timestamp":"2026-08-30T17:41:31.111Z","effort":"high","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
{"parentUuid":"c765ed03-8e36-4ded-94d5-bf8baa34e44c","isSidechain":true,"promptId":"e22f4082-815d-4291-8ec0-471a24337109","agentId":"a348f3ee234ac4fb3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01237re1ogEKc6MsD8nVQ4ch","type":"tool_result","content":"1\t\"\"\"Sector bases: intertwiner spaces Hom_2I(V_n, W_rho) and section bases for\n2\tall sectors at all required levels.\n3\t\n4\tThe deterministic construction per § 3: stacked-constraint SVD over the\n5\tgenerating pair, Lowdin orthonormalization against the per-level Gram, sign\n6\tfixed by the first nonzero component.\n7\t\n8\tEach section f_{i,j}(x) = A_i * pi_n(x) * e_j takes values in W_rho,\n9\twhere A_i is d_rho x (n+1), pi_n(x) is the unitarized Sym^n at point x,\n10\tand e_j is the j-th standard basis vector.\n11\t\"\"\"\n12\timport numpy as np\n13\timport hashlib\n14\tfrom scipy.linalg import sqrtm, svd as scipy_svd\n15\tfrom build.group import (G120, GEN_INDICES, IRREP_NAMES, DIMS, D_RHO,\n16\t                          multiplicity, pi_n_unitary, pi_n_mono, _sym_gram,\n17\t                          rep_rho, ALL_REPS, qmul, quat_to_su2, sym_power)\n18\t\n19\t\n20\tdef compute_intertwiners(rho, n):\n21\t    \"\"\"Compute Hom_2I(V_n, W_rho) via stacked equivariance constraints\n22\t    rho(g) A = A pi_n(g) over the generating pair, in the UNITARIZED basis.\n23\t\n24\t    Uses the CG-recurrence-based pi_n_unitary for numerical stability at all n.\n25\t\n26\t    Returns array of shape (mult, d_rho, n+1) in the UNITARIZED bases.\n27\t    \"\"\"\n28\t    d_rho = DIMS[rho]\n29\t    dim_n = n + 1\n30\t    if d_rho == 0 or dim_n == 0:\n31\t        return np.zeros((0, 0, 0), dtype=complex)\n32\t\n33\t    m = multiplicity(rho, n)\n34\t    if m == 0:\n35\t        return np.zeros((0, d_rho, dim_n), dtype=complex)\n36\t\n37\t    vec_dim = d_rho * dim_n\n38\t\n39\t    rows = []\n40\t    for gen_idx in GEN_INDICES:\n41\t        rho_g = ALL_REPS[rho][gen_idx]\n42\t        pi_g = pi_n_unitary(n, G120[gen_idx])\n43\t        C = np.kron(np.eye(dim_n), rho_g) - np.kron(pi_g.T, np.eye(d_rho))\n44\t        rows.append(C)\n45\t    M = np.vstack(rows)\n46\t\n47\t    U, S, Vh = scipy_svd(M, full_matrices=True, lapack_driver='gesvd')\n48\t    tol = max(1e-10 * S[0], 1e-12) if len(S) > 0 else 1e-12\n49\t    null_mask = S < tol\n50\t    n_null_from_sv = null_mask.sum()\n51\t    n_trailing = max(0, Vh.shape[0] - len(S))\n52\t    n_null = n_null_from_sv + n_trailing\n53\t\n54\t    assert n_null == m, f\"expected mult {m} for {rho} at n={n}, got nullity {n_null}\"\n55\t\n56\t    null_vecs = Vh[-n_null:]\n57\t    # kron uses column-major vectorization: reshape accordingly\n58\t    intertwiners = np.array([v.reshape(dim_n, d_rho).T for v in null_vecs])\n59\t\n60\t    # sign fix: first nonzero component has positive real part\n61\t    for i in range(m):\n62\t        flat = intertwiners[i].ravel()\n63\t        for c in flat:\n64\t            if abs(c) > 1e-14:\n65\t                phase = c / abs(c)\n66\t                intertwiners[i] /= phase\n67\t                break\n68\t\n69\t    return intertwiners\n70\t\n71\t\n72\tdef level_gram_analytic(n):\n73\t    \"\"\"Per-level Gram matrix for sections in the UNITARIZED basis.\n74\t\n75\t    For the unitarized representation, Schur orthogonality gives:\n76\t    integral pi_n_u(x)^H pi_n_u(x) dx = I / (n+1)\n77\t\n78\t    So for sections f_{i,j}(x) = A_i pi_n_u(x) e_j:\n79\t    <f_{i,j}, f_{k,l}> = sum_alpha,b,c [A_i^H]_{b,alpha} [A_k]_{alpha,c} delta_{jl} / (n+1)\n80\t    = delta_{jl} [A_i^H A_k]_{j...} ...\n81\t\n82\t    Actually, more carefully:\n83\t    <f_{i,j}, f_{k,l}> = integral sum_a f_{i,j,a}(x)* f_{k,l,a}(x) dx\n84\t    = integral sum_a (sum_b [A_i]_{a,b} [pi_n(x)]_{b,j})* (sum_c [A_k]_{a,c} [pi_n(x)]_{c,l}) dx\n85\t    = sum_{a,b,c} [A_i]_{a,b}* [A_k]_{a,c} integral [pi_n(x)]_{b,j}* [pi_n(x)]_{c,l} dx\n86\t\n87\t    For UNITARIZED pi_n: integral [pi_n_u]_{bj}* [pi_n_u]_{cl} dx = delta_{bc} delta_{jl} / (n+1)\n88\t\n89\t    So <f_{i,j}, f_{k,l}> = delta_{jl} / (n+1) * sum_a [A_i]_{a,j}* [A_k]_{a,j}\n90\t    Wait, that's not right. Let me redo:\n91\t    = sum_{a,b,c} [A_i*]_{a,b} [A_k]_{a,c} * delta_{bc} delta_{jl} / (n+1)\n92\t    = delta_{jl} / (n+1) * sum_{a,b} [A_i*]_{a,b} [A_k]_{a,b}\n93\t    = delta_{jl} / (n+1) * tr(A_i^H A_k)\n94\t\n95\t    Hmm, but that means the Gram in the (i,j) indices is:\n96\t    G_{(i,j),(k,l)} = delta_{jl} / (n+1) * tr(A_i^H A_k)\n97\t\n98\t    This is block-diagonal in j,l with the intertwiner overlap matrix\n99\t    H_{ik} = tr(A_i^H A_k) / (n+1) replicated (n+1) times.\n100\t\n101\t    Lowdin orthonormalization on this Gram makes the basis orthonormal.\n102\t    \"\"\"\n103\t    pass  # we compute it numerically via quadrature for safety\n104\t\n105\t\n106\tdef hopf_rule(D):\n107\t    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n108\t    Returns (nodes, weights) with weights normalized to sum to 1.\"\"\"\n109\t    K = D + 1\n110\t    nu = D // 2 + 1\n111\t    xs, ws = np.polynomial.legendre.leggauss(nu)\n112\t    u = (xs + 1) / 2\n113\t    wu = ws / 2\n114\t    xi = 2 * np.pi * np.arange(K) / K\n115\t    ce, se = np.sqrt(1 - u), np.sqrt(u)\n116\t    X, W = [], []\n117\t    for cu, su, w in zip(ce, se, wu):\n118\t        for a in xi:\n119\t            for b in xi:\n120\t                X.append([cu * np.cos(a), cu * np.sin(a),\n121\t                          su * np.cos(b), su * np.sin(b)])\n122\t                W.append(w)\n123\t    X = np.array(X)\n124\t    W = np.array(W)\n125\t    W /= W.sum()\n126\t    return X, W\n127\t\n128\t\n129\tdef eval_pi_n_unitary_at_nodes(n, nodes):\n130\t    \"\"\"Evaluate pi_n_unitary at each node. Returns array of shape (n_nodes, n+1, n+1).\"\"\"\n131\t    g = _sym_gram(n)\n132\t    Dh = np.diag(np.sqrt(g))\n133\t    Dih = np.diag(1.0 / np.sqrt(g))\n134\t    result = np.zeros((len(nodes), n + 1, n + 1), dtype=complex)\n135\t    for i, x in enumerate(nodes):\n136\t        M = quat_to_su2(np.asarray(x, float))\n137\t        result[i] = Dh @ sym_power(M, n) @ Dih\n138\t    return result\n139\t\n140\t\n141\tdef build_basis_object(rho, N_max):\n142\t    \"\"\"Build the § 3 basis object for sector rho at all levels n = 0..N_max.\n143\t\n144\t    Returns a dict: level n -> array of shape (total_modes_at_n, d_rho)\n145\t    where total_modes_at_n = mult(rho, n) * (n+1), representing the\n146\t    section coefficients in the unitarized harmonic basis.\n147\t\n148\t    The basis is Lowdin-orthonormalized and sign-fixed per § 3's construction.\n149\t    \"\"\"\n150\t    d_rho = DIMS[rho]\n151\t    basis = {}\n152\t\n153\t    for n in range(N_max + 1):\n154\t        m = multiplicity(rho, n)\n155\t        if m == 0:\n156\t            continue\n157\t        dim_n = n + 1\n158\t        total = m * dim_n\n159\t\n160\t        # compute intertwiners (shape: m x d_rho x dim_n)\n161\t        A = compute_intertwiners(rho, n)\n162\t        assert A.shape == (m, d_rho, dim_n)\n163\t\n164\t        # Gram matrix for the section basis:\n165\t        # G_{(i,j),(k,l)} = delta_{jl} * tr(A_i^H A_k) / (n+1)\n166\t        # This is block diagonal: for each j, the m x m block is H / (n+1)\n167\t        # where H_{ik} = tr(A_i^H A_k)\n168\t        H = np.zeros((m, m), dtype=complex)\n169\t        for i in range(m):\n170\t            for k in range(m):\n171\t                H[i, k] = np.trace(A[i].conj().T @ A[k])\n172\t        H /= (n + 1)\n173\t\n174\t        # Lowdin: B = H^{-1/2}, applied to each j-block independently\n175\t        # Since H is the same for all j, this simplifies\n176\t        H_half = sqrtm(H)\n177\t        try:\n178\t            B = np.linalg.inv(H_half)\n179\t        except np.linalg.LinAlgError:\n180\t            raise RuntimeError(f\"singular Gram at {rho}, n={n}\")\n181\t\n182\t        # orthonormalized intertwiners: A_orth = sum_k B_{ik} A_k\n183\t        A_orth = np.einsum('ik,kab->iab', B, A)\n184\t\n185\t        # verify orthonormality\n186\t        H_check = np.zeros((m, m), dtype=complex)\n187\t        for i in range(m):\n188\t            for k in range(m):\n189\t                H_check[i, k] = np.trace(A_orth[i].conj().T @ A_orth[k])\n190\t        H_check /= (n + 1)\n191\t        assert np.abs(H_check - np.eye(m)).max() < 1e-10, \\\n192\t            f\"Lowdin failed at {rho}, n={n}: {np.abs(H_check - np.eye(m)).max():.2e}\"\n193\t\n194\t        # sign fix each intertwiner\n195\t        for i in range(m):\n196\t            flat = A_orth[i].ravel()\n197\t            for c in flat:\n198\t                if abs(c) > 1e-14:\n199\t                    phase = c / abs(c)\n200\t                    A_orth[i] /= phase\n201\t                    break\n202\t\n203\t        basis[n] = A_orth  # shape (m, d_rho, dim_n)\n204\t\n205\t    return basis\n206\t\n207\t\n208\tdef basis_hash(basis_obj, rho):\n209\t    \"\"\"SHA-256 of the basis object's canonical serialization.\n210\t    Coefficients as little-endian float64 (real, imag) pairs in level-major,\n211\t    then intertwiner-index, then row, then column order.\"\"\"\n212\t    h = hashlib.sha256()\n213\t    for n in sorted(basis_obj.keys()):\n214\t        A = basis_obj[n]  # (m, d_rho, dim_n)\n215\t        for i in range(A.shape[0]):\n216\t            for r in range(A.shape[1]):\n217\t                for c in range(A.shape[2]):\n218\t                    z = A[i, r, c]\n219\t                    h.update(np.float64(z.real).tobytes())\n220\t                    h.update(np.float64(z.imag).tobytes())\n221\t    return h.hexdigest()\n222\t\n223\t\n224\tdef total_modes(rho, N):\n225\t    \"\"\"Total complex Galerkin modes in sector rho at cutoff N.\"\"\"\n226\t    return sum(multiplicity(rho, n) * (n + 1) for n in range(N + 1))\n227\t"}]},"uuid":"f1972c4e-ce07-44fa-a0d9-2667a1ce488c","timestamp":"2026-08-30T17:41:31.113Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/sections.py","content":"\"\"\"Sector bases: intertwiner spaces Hom_2I(V_n, W_rho) and section bases for\nall sectors at all required levels.\n\nThe deterministic construction per § 3: stacked-constraint SVD over the\ngenerating pair, Lowdin orthonormalization against the per-level Gram, sign\nfixed by the first nonzero component.\n\nEach section f_{i,j}(x) = A_i * pi_n(x) * e_j takes values in W_rho,\nwhere A_i is d_rho x (n+1), pi_n(x) is the unitarized Sym^n at point x,\nand e_j is the j-th standard basis vector.\n\"\"\"\nimport numpy as np\nimport hashlib\nfrom scipy.linalg import sqrtm, svd as scipy_svd\nfrom build.group import (G120, GEN_INDICES, IRREP_NAMES, DIMS, D_RHO,\n                          multiplicity, pi_n_unitary, pi_n_mono, _sym_gram,\n                          rep_rho, ALL_REPS, qmul, quat_to_su2, sym_power)\n\n\ndef compute_intertwiners(rho, n):\n    \"\"\"Compute Hom_2I(V_n, W_rho) via stacked equivariance constraints\n    rho(g) A = A pi_n(g) over the generating pair, in the UNITARIZED basis.\n\n    Uses the CG-recurrence-based pi_n_unitary for numerical stability at all n.\n\n    Returns array of shape (mult, d_rho, n+1) in the UNITARIZED bases.\n    \"\"\"\n    d_rho = DIMS[rho]\n    dim_n = n + 1\n    if d_rho == 0 or dim_n == 0:\n        return np.zeros((0, 0, 0), dtype=complex)\n\n    m = multiplicity(rho, n)\n    if m == 0:\n        return np.zeros((0, d_rho, dim_n), dtype=complex)\n\n    vec_dim = d_rho * dim_n\n\n    rows = []\n    for gen_idx in GEN_INDICES:\n        rho_g = ALL_REPS[rho][gen_idx]\n        pi_g = pi_n_unitary(n, G120[gen_idx])\n        C = np.kron(np.eye(dim_n), rho_g) - np.kron(pi_g.T, np.eye(d_rho))\n        rows.append(C)\n    M = np.vstack(rows)\n\n    U, S, Vh = scipy_svd(M, full_matrices=True, lapack_driver='gesvd')\n    tol = max(1e-10 * S[0], 1e-12) if len(S) > 0 else 1e-12\n    null_mask = S < tol\n    n_null_from_sv = null_mask.sum()\n    n_trailing = max(0, Vh.shape[0] - len(S))\n    n_null = n_null_from_sv + n_trailing\n\n    assert n_null == m, f\"expected mult {m} for {rho} at n={n}, got nullity {n_null}\"\n\n    null_vecs = Vh[-n_null:]\n    # kron uses column-major vectorization: reshape accordingly\n    intertwiners = np.array([v.reshape(dim_n, d_rho).T for v in null_vecs])\n\n    # sign fix: first nonzero component has positive real part\n    for i in range(m):\n        flat = intertwiners[i].ravel()\n        for c in flat:\n            if abs(c) > 1e-14:\n                phase = c / abs(c)\n                intertwiners[i] /= phase\n                break\n\n    return intertwiners\n\n\ndef level_gram_analytic(n):\n    \"\"\"Per-level Gram matrix for sections in the UNITARIZED basis.\n\n    For the unitarized representation, Schur orthogonality gives:\n    integral pi_n_u(x)^H pi_n_u(x) dx = I / (n+1)\n\n    So for sections f_{i,j}(x) = A_i pi_n_u(x) e_j:\n    <f_{i,j}, f_{k,l}> = sum_alpha,b,c [A_i^H]_{b,alpha} [A_k]_{alpha,c} delta_{jl} / (n+1)\n    = delta_{jl} [A_i^H A_k]_{j...} ...\n\n    Actually, more carefully:\n    <f_{i,j}, f_{k,l}> = integral sum_a f_{i,j,a}(x)* f_{k,l,a}(x) dx\n    = integral sum_a (sum_b [A_i]_{a,b} [pi_n(x)]_{b,j})* (sum_c [A_k]_{a,c} [pi_n(x)]_{c,l}) dx\n    = sum_{a,b,c} [A_i]_{a,b}* [A_k]_{a,c} integral [pi_n(x)]_{b,j}* [pi_n(x)]_{c,l} dx\n\n    For UNITARIZED pi_n: integral [pi_n_u]_{bj}* [pi_n_u]_{cl} dx = delta_{bc} delta_{jl} / (n+1)\n\n    So <f_{i,j}, f_{k,l}> = delta_{jl} / (n+1) * sum_a [A_i]_{a,j}* [A_k]_{a,j}\n    Wait, that's not right. Let me redo:\n    = sum_{a,b,c} [A_i*]_{a,b} [A_k]_{a,c} * delta_{bc} delta_{jl} / (n+1)\n    = delta_{jl} / (n+1) * sum_{a,b} [A_i*]_{a,b} [A_k]_{a,b}\n    = delta_{jl} / (n+1) * tr(A_i^H A_k)\n\n    Hmm, but that means the Gram in the (i,j) indices is:\n    G_{(i,j),(k,l)} = delta_{jl} / (n+1) * tr(A_i^H A_k)\n\n    This is block-diagonal in j,l with the intertwiner overlap matrix\n    H_{ik} = tr(A_i^H A_k) / (n+1) replicated (n+1) times.\n\n    Lowdin orthonormalization on this Gram makes the basis orthonormal.\n    \"\"\"\n    pass  # we compute it numerically via quadrature for safety\n\n\ndef hopf_rule(D):\n    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n    Returns (nodes, weights) with weights normalized to sum to 1.\"\"\"\n    K = D + 1\n    nu = D // 2 + 1\n    xs, ws = np.polynomial.legendre.leggauss(nu)\n    u = (xs + 1) / 2\n    wu = ws / 2\n    xi = 2 * np.pi * np.arange(K) / K\n    ce, se = np.sqrt(1 - u), np.sqrt(u)\n    X, W = [], []\n    for cu, su, w in zip(ce, se, wu):\n        for a in xi:\n            for b in xi:\n                X.append([cu * np.cos(a), cu * np.sin(a),\n                          su * np.cos(b), su * np.sin(b)])\n                W.append(w)\n    X = np.array(X)\n    W = np.array(W)\n    W /= W.sum()\n    return X, W\n\n\ndef eval_pi_n_unitary_at_nodes(n, nodes):\n    \"\"\"Evaluate pi_n_unitary at each node. Returns array of shape (n_nodes, n+1, n+1).\"\"\"\n    g = _sym_gram(n)\n    Dh = np.diag(np.sqrt(g))\n    Dih = np.diag(1.0 / np.sqrt(g))\n    result = np.zeros((len(nodes), n + 1, n + 1), dtype=complex)\n    for i, x in enumerate(nodes):\n        M = quat_to_su2(np.asarray(x, float))\n        result[i] = Dh @ sym_power(M, n) @ Dih\n    return result\n\n\ndef build_basis_object(rho, N_max):\n    \"\"\"Build the § 3 basis object for sector rho at all levels n = 0..N_max.\n\n    Returns a dict: level n -> array of shape (total_modes_at_n, d_rho)\n    where total_modes_at_n = mult(rho, n) * (n+1), representing the\n    section coefficients in the unitarized harmonic basis.\n\n    The basis is Lowdin-orthonormalized and sign-fixed per § 3's construction.\n    \"\"\"\n    d_rho = DIMS[rho]\n    basis = {}\n\n    for n in range(N_max + 1):\n        m = multiplicity(rho, n)\n        if m == 0:\n            continue\n        dim_n = n + 1\n        total = m * dim_n\n\n        # compute intertwiners (shape: m x d_rho x dim_n)\n        A = compute_intertwiners(rho, n)\n        assert A.shape == (m, d_rho, dim_n)\n\n        # Gram matrix for the section basis:\n        # G_{(i,j),(k,l)} = delta_{jl} * tr(A_i^H A_k) / (n+1)\n        # This is block diagonal: for each j, the m x m block is H / (n+1)\n        # where H_{ik} = tr(A_i^H A_k)\n        H = np.zeros((m, m), dtype=complex)\n        for i in range(m):\n            for k in range(m):\n                H[i, k] = np.trace(A[i].conj().T @ A[k])\n        H /= (n + 1)\n\n        # Lowdin: B = H^{-1/2}, applied to each j-block independently\n        # Since H is the same for all j, this simplifies\n        H_half = sqrtm(H)\n        try:\n            B = np.linalg.inv(H_half)\n        except np.linalg.LinAlgError:\n            raise RuntimeError(f\"singular Gram at {rho}, n={n}\")\n\n        # orthonormalized intertwiners: A_orth = sum_k B_{ik} A_k\n        A_orth = np.einsum('ik,kab->iab', B, A)\n\n        # verify orthonormality\n        H_check = np.zeros((m, m), dtype=complex)\n        for i in range(m):\n            for k in range(m):\n                H_check[i, k] = np.trace(A_orth[i].conj().T @ A_orth[k])\n        H_check /= (n + 1)\n        assert np.abs(H_check - np.eye(m)).max() < 1e-10, \\\n            f\"Lowdin failed at {rho}, n={n}: {np.abs(H_check - np.eye(m)).max():.2e}\"\n\n        # sign fix each intertwiner\n        for i in range(m):\n            flat = A_orth[i].ravel()\n            for c in flat:\n                if abs(c) > 1e-14:\n                    phase = c / abs(c)\n                    A_orth[i] /= phase\n                    break\n\n        basis[n] = A_orth  # shape (m, d_rho, dim_n)\n\n    return basis\n\n\ndef basis_hash(basis_obj, rho):\n    \"\"\"SHA-256 of the basis object's canonical serialization.\n    Coefficients as little-endian float64 (real, imag) pairs in level-major,\n    then intertwiner-index, then row, then column order.\"\"\"\n    h = hashlib.sha256()\n    for n in sorted(basis_obj.keys()):\n        A = basis_obj[n]  # (m, d_rho, dim_n)\n        for i in range(A.shape[0]):\n            for r in range(A.shape[1]):\n                for c in range(A.shape[2]):\n                    z = A[i, r, c]\n                    h.update(np.float64(z.real).tobytes())\n                    h.update(np.float64(z.imag).tobytes())\n    return h.hexdigest()\n\n\ndef total_modes(rho, N):\n    \"\"\"Total complex Galerkin modes in sector rho at cutoff N.\"\"\"\n    return sum(multiplicity(rho, n) * (n + 1) for n in range(N + 1))\n","numLines":227,"startLine":1,"totalLines":227}},"sourceToolAssistantUUID":"c765ed03-8e36-4ded-94d5-bf8baa34e44c","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
{"parentUuid":"b3adf6cc-760e-45c2-8a62-d2f76d239368","isSidechain":true,"promptId":"e22f4082-815d-4291-8ec0-471a24337109","agentId":"a348f3ee234ac4fb3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GHJaaEzjqCoxFp5cVKiQTV","type":"tool_result","content":"1\t\"\"\"Hopf-coordinate quadrature on S^3 for spectral Galerkin methods.\n2\t\n3\tProduct rules on S^3 using Hopf coordinates:\n4\t    x = (cos eta cos xi1, cos eta sin xi1, sin eta cos xi2, sin eta sin xi2)\n5\twith measure proportional to cos(eta) sin(eta) d(eta) d(xi1) d(xi2).\n6\tThe substitution u = sin^2(eta) linearizes the radial part.\n7\t\n8\tQuadrature nodes and weights, plus direct (non-FFT) synthesis and analysis\n9\ttransforms for equivariant section bases.\n10\t\"\"\"\n11\t\n12\timport numpy as np\n13\tfrom build.group import pi_n_unitary, quat_to_su2, _sym_gram, DIMS, multiplicity\n14\t\n15\t\n16\t# ---------------------------------------------------------------------------\n17\t# Quadrature rules\n18\t# ---------------------------------------------------------------------------\n19\t\n20\tdef hopf_rule(D):\n21\t    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n22\t\n23\t    Parameters\n24\t    ----------\n25\t    D : int\n26\t        Maximum polynomial degree for which the rule is exact.\n27\t\n28\t    Returns\n29\t    -------\n30\t    nodes : ndarray, shape (N_nodes, 4)\n31\t        Points on S^3 in Cartesian coordinates.\n32\t    weights : ndarray, shape (N_nodes,)\n33\t        Quadrature weights, normalized so that weights.sum() == 1.\n34\t\n35\t    Notes\n36\t    -----\n37\t    The rule uses:\n38\t    - K = D+1 uniform points in each of xi1, xi2 in [0, 2*pi)\n39\t      (exact for trigonometric polynomials of degree <= D via the DFT).\n40\t    - nu = D//2 + 1 Gauss-Legendre points in u = sin^2(eta) in [0, 1]\n41\t      (exact for polynomials of degree <= 2*nu - 1 >= D in u;\n42\t       the change of variables from eta to u absorbs the cos(eta)*sin(eta)\n43\t       Jacobian, so the u-integrand is a polynomial of degree <= D//2 in u\n44\t       when the angular part has been eliminated by the trapezoidal rule).\n45\t\n46\t    Node count = nu * K^2.\n47\t    \"\"\"\n48\t    K = D + 1\n49\t    nu = D // 2 + 1\n50\t\n51\t    # Gauss-Legendre on [-1, 1], mapped to u in [0, 1]\n52\t    xs, ws = np.polynomial.legendre.leggauss(nu)\n53\t    u = (xs + 1) / 2\n54\t    wu = ws / 2\n55\t\n56\t    # Uniform grid in each angle\n57\t    xi = 2 * np.pi * np.arange(K) / K\n58\t\n59\t    # Precompute cos(eta), sin(eta) from u = sin^2(eta)\n60\t    ce = np.sqrt(1 - u)   # cos(eta)\n61\t    se = np.sqrt(u)        # sin(eta)\n62\t\n63\t    # Build node array and weight array\n64\t    n_nodes = nu * K * K\n65\t    nodes = np.empty((n_nodes, 4))\n66\t    weights = np.empty(n_nodes)\n67\t\n68\t    idx = 0\n69\t    for i_u in range(nu):\n70\t        c, s, w = ce[i_u], se[i_u], wu[i_u]\n71\t        for i_a in range(K):\n72\t            ca, sa = np.cos(xi[i_a]), np.sin(xi[i_a])\n73\t            for i_b in range(K):\n74\t                cb, sb = np.cos(xi[i_b]), np.sin(xi[i_b])\n75\t                nodes[idx, 0] = c * ca\n76\t                nodes[idx, 1] = c * sa\n77\t                nodes[idx, 2] = s * cb\n78\t                nodes[idx, 3] = s * sb\n79\t                weights[idx] = w\n80\t                idx += 1\n81\t\n82\t    weights /= weights.sum()\n83\t    return nodes, weights\n84\t\n85\t\n86\tdef production_rule(N):\n87\t    \"\"\"4N-exact Hopf rule for Galerkin production integrands at band limit N.\n88\t\n89\t    The cubic nonlinearity |psi|^2 psi with psi band-limited to level N\n90\t    produces integrands of polynomial degree <= 4N when projected onto\n91\t    modes of degree <= N.\n92\t\n93\t    Node count: nu * K^2 where K = 4N+1, nu = 2N+1.\n94\t    So node count = (2N+1) * (4N+1)^2.\n95\t\n96\t    Parameters\n97\t    ----------\n98\t    N : int\n99\t        Band limit of the field.\n100\t\n101\t    Returns\n102\t    -------\n103\t    nodes : ndarray, shape (N_nodes, 4)\n104\t    weights : ndarray, shape (N_nodes,)\n105\t    \"\"\"\n106\t    return hopf_rule(4 * N)\n107\t\n108\t\n109\tdef monitor_rule(N):\n110\t    \"\"\"6N-exact Hopf rule for cascade-monitor integrands at band limit N.\n111\t\n112\t    The cascade monitor measures the band N < n <= 3N of |psi|^2 psi.\n113\t    Projecting onto modes of degree up to 3N against a degree-3N integrand\n114\t    requires exactness to degree 6N.\n115\t\n116\t    Node count: nu * K^2 where K = 6N+1, nu = 3N+1.\n117\t    So node count = (3N+1) * (6N+1)^2.\n118\t\n119\t    Parameters\n120\t    ----------\n121\t    N : int\n122\t        Band limit of the field.\n123\t\n124\t    Returns\n125\t    -------\n126\t    nodes : ndarray, shape (N_nodes, 4)\n127\t    weights : ndarray, shape (N_nodes,)\n128\t    \"\"\"\n129\t    return hopf_rule(6 * N)\n130\t\n131\t\n132\t# ---------------------------------------------------------------------------\n133\t# Representation evaluation at nodes\n134\t# ---------------------------------------------------------------------------\n135\t\n136\tdef eval_pi_n_unitary_at_nodes(n, nodes):\n137\t    \"\"\"Evaluate the unitarized n-th symmetric power at each quadrature node.\n138\t\n139\t    Parameters\n140\t    ----------\n141\t    n : int\n142\t        Representation level (dimension = n+1).\n143\t    nodes : ndarray, shape (N_nodes, 4)\n144\t        Points on S^3 (unit quaternions).\n145\t\n146\t    Returns\n147\t    -------\n148\t    pi_vals : ndarray, shape (N_nodes, n+1, n+1), dtype complex\n149\t        pi_vals[i] = pi_n_unitary(n, nodes[i]).\n150\t    \"\"\"\n151\t    if n == 0:\n152\t        return np.ones((len(nodes), 1, 1), dtype=complex)\n153\t\n154\t    n_nodes = len(nodes)\n155\t    dim = n + 1\n156\t    result = np.empty((n_nodes, dim, dim), dtype=complex)\n157\t\n158\t    for i in range(n_nodes):\n159\t        result[i] = pi_n_unitary(n, nodes[i])\n160\t\n161\t    return result\n162\t\n163\t\n164\t# ---------------------------------------------------------------------------\n165\t# Section evaluation\n166\t# ---------------------------------------------------------------------------\n167\t\n168\tdef eval_section_at_nodes(intertwiner, n, nodes, pi_cache=None):\n169\t    \"\"\"Evaluate one intertwiner's section basis functions at quadrature nodes.\n170\t\n171\t    For intertwiner A of shape (d_rho, n+1), the section basis functions are:\n172\t        f_{A,j}(x) = A . pi_n_unitary(x) . e_j    for j = 0, ..., n\n173\t\n174\t    giving a d_rho-valued function for each j.\n175\t\n176\t    Parameters\n177\t    ----------\n178\t    intertwiner : ndarray, shape (d_rho, n+1)\n179\t        The intertwiner matrix A.\n180\t    n : int\n181\t        Representation level.\n182\t    nodes : ndarray, shape (N_nodes, 4)\n183\t        Quadrature nodes on S^3.\n184\t    pi_cache : ndarray, shape (N_nodes, n+1, n+1) or None\n185\t        Precomputed pi_n_unitary values. If None, they are computed here.\n186\t\n187\t    Returns\n188\t    -------\n189\t    values : ndarray, shape (N_nodes, d_rho, n+1)\n190\t        values[i, a, j] = sum_b A[a,b] * pi_n_unitary(nodes[i])[b,j].\n191\t    \"\"\"\n192\t    if pi_cache is None:\n193\t        pi_cache = eval_pi_n_unitary_at_nodes(n, nodes)\n194\t\n195\t    # intertwiner is (d_rho, dim_n), pi_cache is (N_nodes, dim_n, dim_n)\n196\t    # result[i] = A @ pi_cache[i], shape (d_rho, dim_n)\n197\t    # Use einsum: result[i, a, j] = sum_b A[a,b] * pi_cache[i,b,j]\n198\t    values = np.einsum('ab,ibj->iaj', intertwiner, pi_cache)\n199\t    return values\n200\t\n201\t\n202\t# ---------------------------------------------------------------------------\n203\t# Direct synthesis (coefficients -> field values at nodes)\n204\t# ---------------------------------------------------------------------------\n205\t\n206\tdef synthesis(coefficients, basis_obj, nodes, rho=None):\n207\t    \"\"\"Evaluate an equivariant field at quadrature nodes from Galerkin coefficients.\n208\t\n209\t    The field is:\n210\t        psi(x) = sum_{n} sum_{i=0}^{m_n-1} sum_{j=0}^{n}\n211\t                     c_{n,i,j} * A_{n,i} . pi_n(x) . e_j\n212\t\n213\t    where A_{n,i} are the orthonormalized intertwiners from basis_obj.\n214\t\n215\t    Parameters\n216\t    ----------\n217\t    coefficients : ndarray, shape (N_total,) complex\n218\t        Galerkin coefficients in level-major, intertwiner-index, then j order.\n219\t        N_total = sum over active levels of mult(rho, n) * (n+1).\n220\t    basis_obj : dict\n221\t        level n -> ndarray of shape (mult, d_rho, n+1), the orthonormalized\n222\t        intertwiners. Produced by sections.build_basis_object().\n223\t    nodes : ndarray, shape (N_nodes, 4)\n224\t        Quadrature nodes on S^3.\n225\t    rho : str or None\n226\t        Sector name (for extracting d_rho). If None, inferred from basis_obj.\n227\t\n228\t    Returns\n229\t    -------\n230\t    field : ndarray, shape (N_nodes, d_rho), dtype complex\n231\t        The field evaluated at each node.\n232\t    \"\"\"\n233\t    # Determine d_rho from the first available level\n234\t    levels = sorted(basis_obj.keys())\n235\t    if len(levels) == 0:\n236\t        raise ValueError(\"empty basis_obj\")\n237\t    d_rho = basis_obj[levels[0]].shape[1]\n238\t\n239\t    n_nodes = len(nodes)\n240\t    field = np.zeros((n_nodes, d_rho), dtype=complex)\n241\t\n242\t    # Walk through coefficients level by level\n243\t    offset = 0\n244\t    for n in levels:\n245\t        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n246\t        m = A_all.shape[0]\n247\t        dim_n = n + 1\n248\t        block_size = m * dim_n\n249\t\n250\t        # Extract this level's coefficients: shape (m, dim_n)\n251\t        c_block = coefficients[offset:offset + block_size].reshape(m, dim_n)\n252\t        offset += block_size\n253\t\n254\t        # Compute pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n255\t        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n256\t\n257\t        # For each intertwiner i and column j:\n258\t        #   contribution = c_{n,i,j} * A_{n,i} @ pi_n(x) @ e_j\n259\t        # Vectorized: for intertwiner i,\n260\t        #   A_i @ pi_vals[node] has shape (d_rho, dim_n)\n261\t        #   sum over j of c[i,j] * (A_i @ pi_vals)[node, :, j]\n262\t        #     = A_i @ pi_vals[node] @ c[i, :]\n263\t\n264\t        # section_vals[i, node, :] = A_i @ pi_vals[node] @ c[i, :]\n265\t        for i in range(m):\n266\t            # A_all[i] @ pi_vals: shape (N_nodes, d_rho, dim_n)\n267\t            Apn = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n268\t            # Contract with c_block[i]: (N_nodes, d_rho)\n269\t            field += np.einsum('naj,j->na', Apn, c_block[i])\n270\t\n271\t    return field\n272\t\n273\t\n274\t# ---------------------------------------------------------------------------\n275\t# Direct analysis (field values at nodes -> coefficients)\n276\t# ---------------------------------------------------------------------------\n277\t\n278\tdef analysis(field_values, basis_obj, nodes, weights):\n279\t    \"\"\"Compute Galerkin coefficients from field values at quadrature nodes.\n280\t\n281\t    This is the quadrature-weighted adjoint of synthesis:\n282\t        c_{n,i,j} = sum_nodes w_node * f_{n,i,j}(x_node)^H . psi(x_node)\n283\t\n284\t    where f_{n,i,j}(x) = A_{n,i} . pi_n(x) . e_j is the section basis function.\n285\t\n286\t    For orthonormal sections and an exact-enough rule, analysis(synthesis(c)) = c.\n287\t\n288\t    Parameters\n289\t    ----------\n290\t    field_values : ndarray, shape (N_nodes, d_rho), dtype complex\n291\t        The field evaluated at each node.\n292\t    basis_obj : dict\n293\t        level n -> ndarray of shape (mult, d_rho, n+1).\n294\t    nodes : ndarray, shape (N_nodes, 4)\n295\t        Quadrature nodes on S^3.\n296\t    weights : ndarray, shape (N_nodes,)\n297\t        Quadrature weights (summing to 1).\n298\t\n299\t    Returns\n300\t    -------\n301\t    coefficients : ndarray, shape (N_total,), dtype complex\n302\t        Galerkin coefficients in level-major order.\n303\t    \"\"\"\n304\t    levels = sorted(basis_obj.keys())\n305\t    if len(levels) == 0:\n306\t        raise ValueError(\"empty basis_obj\")\n307\t\n308\t    # Weighted field values: shape (N_nodes, d_rho)\n309\t    weighted_field = weights[:, None] * field_values\n310\t\n311\t    coeffs_list = []\n312\t\n313\t    for n in levels:\n314\t        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n315\t        m = A_all.shape[0]\n316\t        dim_n = n + 1\n317\t\n318\t        # pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n319\t        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n320\t\n321\t        c_block = np.zeros((m, dim_n), dtype=complex)\n322\t\n323\t        for i in range(m):\n324\t            # Section basis values: f_{i,j}(x)[a] = sum_b A[a,b] pi[b,j]\n325\t            # f_vals shape: (N_nodes, d_rho, dim_n)\n326\t            f_vals = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n327\t\n328\t            # Inner product: c[i,j] = sum_node sum_a w[node] * f[node,a,j]^* * psi[node,a]\n329\t            # = sum_node sum_a f_vals[node,a,j]^* * weighted_field[node,a]\n330\t            c_block[i] = np.einsum('naj,na->j', f_vals.conj(), weighted_field)\n331\t\n332\t        # No normalization factor needed: the Lowdin-orthonormalized\n333\t        # intertwiners satisfy tr(A_i^H A_k) / (n+1) = delta_{ik},\n334\t        # which combined with Schur orthogonality (integral of\n335\t        # pi[b,j]^* pi[c,l] = delta_{bc} delta_{jl} / (n+1)) gives\n336\t        # orthonormal sections: <f_{i,j}, f_{k,l}> = delta_{ik} delta_{jl}.\n337\t\n338\t        coeffs_list.append(c_block.ravel())\n339\t\n340\t    return np.concatenate(coeffs_list)\n341\t"}]},"uuid":"c418f64f-e569-4be0-8e28-3244f823d6e2","timestamp":"2026-08-30T17:41:31.116Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/quadrature.py","content":"\"\"\"Hopf-coordinate quadrature on S^3 for spectral Galerkin methods.\n\nProduct rules on S^3 using Hopf coordinates:\n    x = (cos eta cos xi1, cos eta sin xi1, sin eta cos xi2, sin eta sin xi2)\nwith measure proportional to cos(eta) sin(eta) d(eta) d(xi1) d(xi2).\nThe substitution u = sin^2(eta) linearizes the radial part.\n\nQuadrature nodes and weights, plus direct (non-FFT) synthesis and analysis\ntransforms for equivariant section bases.\n\"\"\"\n\nimport numpy as np\nfrom build.group import pi_n_unitary, quat_to_su2, _sym_gram, DIMS, multiplicity\n\n\n# ---------------------------------------------------------------------------\n# Quadrature rules\n# ---------------------------------------------------------------------------\n\ndef hopf_rule(D):\n    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n\n    Parameters\n    ----------\n    D : int\n        Maximum polynomial degree for which the rule is exact.\n\n    Returns\n    -------\n    nodes : ndarray, shape (N_nodes, 4)\n        Points on S^3 in Cartesian coordinates.\n    weights : ndarray, shape (N_nodes,)\n        Quadrature weights, normalized so that weights.sum() == 1.\n\n    Notes\n    -----\n    The rule uses:\n    - K = D+1 uniform points in each of xi1, xi2 in [0, 2*pi)\n      (exact for trigonometric polynomials of degree <= D via the DFT).\n    - nu = D//2 + 1 Gauss-Legendre points in u = sin^2(eta) in [0, 1]\n      (exact for polynomials of degree <= 2*nu - 1 >= D in u;\n       the change of variables from eta to u absorbs the cos(eta)*sin(eta)\n       Jacobian, so the u-integrand is a polynomial of degree <= D//2 in u\n       when the angular part has been eliminated by the trapezoidal rule).\n\n    Node count = nu * K^2.\n    \"\"\"\n    K = D + 1\n    nu = D // 2 + 1\n\n    # Gauss-Legendre on [-1, 1], mapped to u in [0, 1]\n    xs, ws = np.polynomial.legendre.leggauss(nu)\n    u = (xs + 1) / 2\n    wu = ws / 2\n\n    # Uniform grid in each angle\n    xi = 2 * np.pi * np.arange(K) / K\n\n    # Precompute cos(eta), sin(eta) from u = sin^2(eta)\n    ce = np.sqrt(1 - u)   # cos(eta)\n    se = np.sqrt(u)        # sin(eta)\n\n    # Build node array and weight array\n    n_nodes = nu * K * K\n    nodes = np.empty((n_nodes, 4))\n    weights = np.empty(n_nodes)\n\n    idx = 0\n    for i_u in range(nu):\n        c, s, w = ce[i_u], se[i_u], wu[i_u]\n        for i_a in range(K):\n            ca, sa = np.cos(xi[i_a]), np.sin(xi[i_a])\n            for i_b in range(K):\n                cb, sb = np.cos(xi[i_b]), np.sin(xi[i_b])\n                nodes[idx, 0] = c * ca\n                nodes[idx, 1] = c * sa\n                nodes[idx, 2] = s * cb\n                nodes[idx, 3] = s * sb\n                weights[idx] = w\n                idx += 1\n\n    weights /= weights.sum()\n    return nodes, weights\n\n\ndef production_rule(N):\n    \"\"\"4N-exact Hopf rule for Galerkin production integrands at band limit N.\n\n    The cubic nonlinearity |psi|^2 psi with psi band-limited to level N\n    produces integrands of polynomial degree <= 4N when projected onto\n    modes of degree <= N.\n\n    Node count: nu * K^2 where K = 4N+1, nu = 2N+1.\n    So node count = (2N+1) * (4N+1)^2.\n\n    Parameters\n    ----------\n    N : int\n        Band limit of the field.\n\n    Returns\n    -------\n    nodes : ndarray, shape (N_nodes, 4)\n    weights : ndarray, shape (N_nodes,)\n    \"\"\"\n    return hopf_rule(4 * N)\n\n\ndef monitor_rule(N):\n    \"\"\"6N-exact Hopf rule for cascade-monitor integrands at band limit N.\n\n    The cascade monitor measures the band N < n <= 3N of |psi|^2 psi.\n    Projecting onto modes of degree up to 3N against a degree-3N integrand\n    requires exactness to degree 6N.\n\n    Node count: nu * K^2 where K = 6N+1, nu = 3N+1.\n    So node count = (3N+1) * (6N+1)^2.\n\n    Parameters\n    ----------\n    N : int\n        Band limit of the field.\n\n    Returns\n    -------\n    nodes : ndarray, shape (N_nodes, 4)\n    weights : ndarray, shape (N_nodes,)\n    \"\"\"\n    return hopf_rule(6 * N)\n\n\n# ---------------------------------------------------------------------------\n# Representation evaluation at nodes\n# ---------------------------------------------------------------------------\n\ndef eval_pi_n_unitary_at_nodes(n, nodes):\n    \"\"\"Evaluate the unitarized n-th symmetric power at each quadrature node.\n\n    Parameters\n    ----------\n    n : int\n        Representation level (dimension = n+1).\n    nodes : ndarray, shape (N_nodes, 4)\n        Points on S^3 (unit quaternions).\n\n    Returns\n    -------\n    pi_vals : ndarray, shape (N_nodes, n+1, n+1), dtype complex\n        pi_vals[i] = pi_n_unitary(n, nodes[i]).\n    \"\"\"\n    if n == 0:\n        return np.ones((len(nodes), 1, 1), dtype=complex)\n\n    n_nodes = len(nodes)\n    dim = n + 1\n    result = np.empty((n_nodes, dim, dim), dtype=complex)\n\n    for i in range(n_nodes):\n        result[i] = pi_n_unitary(n, nodes[i])\n\n    return result\n\n\n# ---------------------------------------------------------------------------\n# Section evaluation\n# ---------------------------------------------------------------------------\n\ndef eval_section_at_nodes(intertwiner, n, nodes, pi_cache=None):\n    \"\"\"Evaluate one intertwiner's section basis functions at quadrature nodes.\n\n    For intertwiner A of shape (d_rho, n+1), the section basis functions are:\n        f_{A,j}(x) = A . pi_n_unitary(x) . e_j    for j = 0, ..., n\n\n    giving a d_rho-valued function for each j.\n\n    Parameters\n    ----------\n    intertwiner : ndarray, shape (d_rho, n+1)\n        The intertwiner matrix A.\n    n : int\n        Representation level.\n    nodes : ndarray, shape (N_nodes, 4)\n        Quadrature nodes on S^3.\n    pi_cache : ndarray, shape (N_nodes, n+1, n+1) or None\n        Precomputed pi_n_unitary values. If None, they are computed here.\n\n    Returns\n    -------\n    values : ndarray, shape (N_nodes, d_rho, n+1)\n        values[i, a, j] = sum_b A[a,b] * pi_n_unitary(nodes[i])[b,j].\n    \"\"\"\n    if pi_cache is None:\n        pi_cache = eval_pi_n_unitary_at_nodes(n, nodes)\n\n    # intertwiner is (d_rho, dim_n), pi_cache is (N_nodes, dim_n, dim_n)\n    # result[i] = A @ pi_cache[i], shape (d_rho, dim_n)\n    # Use einsum: result[i, a, j] = sum_b A[a,b] * pi_cache[i,b,j]\n    values = np.einsum('ab,ibj->iaj', intertwiner, pi_cache)\n    return values\n\n\n# ---------------------------------------------------------------------------\n# Direct synthesis (coefficients -> field values at nodes)\n# ---------------------------------------------------------------------------\n\ndef synthesis(coefficients, basis_obj, nodes, rho=None):\n    \"\"\"Evaluate an equivariant field at quadrature nodes from Galerkin coefficients.\n\n    The field is:\n        psi(x) = sum_{n} sum_{i=0}^{m_n-1} sum_{j=0}^{n}\n                     c_{n,i,j} * A_{n,i} . pi_n(x) . e_j\n\n    where A_{n,i} are the orthonormalized intertwiners from basis_obj.\n\n    Parameters\n    ----------\n    coefficients : ndarray, shape (N_total,) complex\n        Galerkin coefficients in level-major, intertwiner-index, then j order.\n        N_total = sum over active levels of mult(rho, n) * (n+1).\n    basis_obj : dict\n        level n -> ndarray of shape (mult, d_rho, n+1), the orthonormalized\n        intertwiners. Produced by sections.build_basis_object().\n    nodes : ndarray, shape (N_nodes, 4)\n        Quadrature nodes on S^3.\n    rho : str or None\n        Sector name (for extracting d_rho). If None, inferred from basis_obj.\n\n    Returns\n    -------\n    field : ndarray, shape (N_nodes, d_rho), dtype complex\n        The field evaluated at each node.\n    \"\"\"\n    # Determine d_rho from the first available level\n    levels = sorted(basis_obj.keys())\n    if len(levels) == 0:\n        raise ValueError(\"empty basis_obj\")\n    d_rho = basis_obj[levels[0]].shape[1]\n\n    n_nodes = len(nodes)\n    field = np.zeros((n_nodes, d_rho), dtype=complex)\n\n    # Walk through coefficients level by level\n    offset = 0\n    for n in levels:\n        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n        m = A_all.shape[0]\n        dim_n = n + 1\n        block_size = m * dim_n\n\n        # Extract this level's coefficients: shape (m, dim_n)\n        c_block = coefficients[offset:offset + block_size].reshape(m, dim_n)\n        offset += block_size\n\n        # Compute pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n\n        # For each intertwiner i and column j:\n        #   contribution = c_{n,i,j} * A_{n,i} @ pi_n(x) @ e_j\n        # Vectorized: for intertwiner i,\n        #   A_i @ pi_vals[node] has shape (d_rho, dim_n)\n        #   sum over j of c[i,j] * (A_i @ pi_vals)[node, :, j]\n        #     = A_i @ pi_vals[node] @ c[i, :]\n\n        # section_vals[i, node, :] = A_i @ pi_vals[node] @ c[i, :]\n        for i in range(m):\n            # A_all[i] @ pi_vals: shape (N_nodes, d_rho, dim_n)\n            Apn = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n            # Contract with c_block[i]: (N_nodes, d_rho)\n            field += np.einsum('naj,j->na', Apn, c_block[i])\n\n    return field\n\n\n# ---------------------------------------------------------------------------\n# Direct analysis (field values at nodes -> coefficients)\n# ---------------------------------------------------------------------------\n\ndef analysis(field_values, basis_obj, nodes, weights):\n    \"\"\"Compute Galerkin coefficients from field values at quadrature nodes.\n\n    This is the quadrature-weighted adjoint of synthesis:\n        c_{n,i,j} = sum_nodes w_node * f_{n,i,j}(x_node)^H . psi(x_node)\n\n    where f_{n,i,j}(x) = A_{n,i} . pi_n(x) . e_j is the section basis function.\n\n    For orthonormal sections and an exact-enough rule, analysis(synthesis(c)) = c.\n\n    Parameters\n    ----------\n    field_values : ndarray, shape (N_nodes, d_rho), dtype complex\n        The field evaluated at each node.\n    basis_obj : dict\n        level n -> ndarray of shape (mult, d_rho, n+1).\n    nodes : ndarray, shape (N_nodes, 4)\n        Quadrature nodes on S^3.\n    weights : ndarray, shape (N_nodes,)\n        Quadrature weights (summing to 1).\n\n    Returns\n    -------\n    coefficients : ndarray, shape (N_total,), dtype complex\n        Galerkin coefficients in level-major order.\n    \"\"\"\n    levels = sorted(basis_obj.keys())\n    if len(levels) == 0:\n        raise ValueError(\"empty basis_obj\")\n\n    # Weighted field values: shape (N_nodes, d_rho)\n    weighted_field = weights[:, None] * field_values\n\n    coeffs_list = []\n\n    for n in levels:\n        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n        m = A_all.shape[0]\n        dim_n = n + 1\n\n        # pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n\n        c_block = np.zeros((m, dim_n), dtype=complex)\n\n        for i in range(m):\n            # Section basis values: f_{i,j}(x)[a] = sum_b A[a,b] pi[b,j]\n            # f_vals shape: (N_nodes, d_rho, dim_n)\n            f_vals = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n\n            # Inner product: c[i,j] = sum_node sum_a w[node] * f[node,a,j]^* * psi[node,a]\n            # = sum_node sum_a f_vals[node,a,j]^* * weighted_field[node,a]\n            c_block[i] = np.einsum('naj,na->j', f_vals.conj(), weighted_field)\n\n        # No normalization factor needed: the Lowdin-orthonormalized\n        # intertwiners satisfy tr(A_i^H A_k) / (n+1) = delta_{ik},\n        # which combined with Schur orthogonality (integral of\n        # pi[b,j]^* pi[c,l] = delta_{bc} delta_{jl} / (n+1)) gives\n        # orthonormal sections: <f_{i,j}, f_{k,l}> = delta_{ik} delta_{jl}.\n\n        coeffs_list.append(c_block.ravel())\n\n    return np.concatenate(coeffs_list)\n","numLines":341,"startLine":1,"totalLines":341}},"sourceToolAssistantUUID":"b3adf6cc-760e-45c2-8a62-d2f76d239368","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
