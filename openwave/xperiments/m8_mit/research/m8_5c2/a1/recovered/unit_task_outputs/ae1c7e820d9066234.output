{"parentUuid":"943d8087-0a97-473c-b139-77ee11a0b1b9","isSidechain":true,"promptId":"e22f4082-815d-4291-8ec0-471a24337109","agentId":"ae1c7e820d9066234","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A6PGWX41F8rCfbzRWfiFDn","type":"tool_result","content":"1\t\"\"\"Sector bases: intertwiner spaces Hom_2I(V_n, W_rho) and section bases for\n2\tall sectors at all required levels.\n3\t\n4\tThe deterministic construction per § 3: stacked-constraint SVD over the\n5\tgenerating pair, Lowdin orthonormalization against the per-level Gram, sign\n6\tfixed by the first nonzero component.\n7\t\n8\tEach section f_{i,j}(x) = A_i * pi_n(x) * e_j takes values in W_rho,\n9\twhere A_i is d_rho x (n+1), pi_n(x) is the unitarized Sym^n at point x,\n10\tand e_j is the j-th standard basis vector.\n11\t\"\"\"\n12\timport numpy as np\n13\timport hashlib\n14\tfrom scipy.linalg import sqrtm, svd as scipy_svd\n15\tfrom build.group import (G120, GEN_INDICES, IRREP_NAMES, DIMS, D_RHO,\n16\t                          multiplicity, pi_n_unitary, pi_n_mono, _sym_gram,\n17\t                          rep_rho, ALL_REPS, qmul, quat_to_su2, sym_power)\n18\t\n19\t\n20\tdef compute_intertwiners(rho, n):\n21\t    \"\"\"Compute Hom_2I(V_n, W_rho) via stacked equivariance constraints\n22\t    rho(g) A = A pi_n(g) over the generating pair, in the UNITARIZED basis.\n23\t\n24\t    Uses the CG-recurrence-based pi_n_unitary for numerical stability at all n.\n25\t\n26\t    Returns array of shape (mult, d_rho, n+1) in the UNITARIZED bases.\n27\t    \"\"\"\n28\t    d_rho = DIMS[rho]\n29\t    dim_n = n + 1\n30\t    if d_rho == 0 or dim_n == 0:\n31\t        return np.zeros((0, 0, 0), dtype=complex)\n32\t\n33\t    m = multiplicity(rho, n)\n34\t    if m == 0:\n35\t        return np.zeros((0, d_rho, dim_n), dtype=complex)\n36\t\n37\t    vec_dim = d_rho * dim_n\n38\t\n39\t    rows = []\n40\t    for gen_idx in GEN_INDICES:\n41\t        rho_g = ALL_REPS[rho][gen_idx]\n42\t        pi_g = pi_n_unitary(n, G120[gen_idx])\n43\t        C = np.kron(np.eye(dim_n), rho_g) - np.kron(pi_g.T, np.eye(d_rho))\n44\t        rows.append(C)\n45\t    M = np.vstack(rows)\n46\t\n47\t    U, S, Vh = scipy_svd(M, full_matrices=True, lapack_driver='gesvd')\n48\t    tol = max(1e-10 * S[0], 1e-12) if len(S) > 0 else 1e-12\n49\t    null_mask = S < tol\n50\t    n_null_from_sv = null_mask.sum()\n51\t    n_trailing = max(0, Vh.shape[0] - len(S))\n52\t    n_null = n_null_from_sv + n_trailing\n53\t\n54\t    assert n_null == m, f\"expected mult {m} for {rho} at n={n}, got nullity {n_null}\"\n55\t\n56\t    null_vecs = Vh[-n_null:]\n57\t    # kron uses column-major vectorization: reshape accordingly\n58\t    intertwiners = np.array([v.reshape(dim_n, d_rho).T for v in null_vecs])\n59\t\n60\t    # sign fix: first nonzero component has positive real part\n61\t    for i in range(m):\n62\t        flat = intertwiners[i].ravel()\n63\t        for c in flat:\n64\t            if abs(c) > 1e-14:\n65\t                phase = c / abs(c)\n66\t                intertwiners[i] /= phase\n67\t                break\n68\t\n69\t    return intertwiners\n70\t\n71\t\n72\tdef level_gram_analytic(n):\n73\t    \"\"\"Per-level Gram matrix for sections in the UNITARIZED basis.\n74\t\n75\t    For the unitarized representation, Schur orthogonality gives:\n76\t    integral pi_n_u(x)^H pi_n_u(x) dx = I / (n+1)\n77\t\n78\t    So for sections f_{i,j}(x) = A_i pi_n_u(x) e_j:\n79\t    <f_{i,j}, f_{k,l}> = sum_alpha,b,c [A_i^H]_{b,alpha} [A_k]_{alpha,c} delta_{jl} / (n+1)\n80\t    = delta_{jl} [A_i^H A_k]_{j...} ...\n81\t\n82\t    Actually, more carefully:\n83\t    <f_{i,j}, f_{k,l}> = integral sum_a f_{i,j,a}(x)* f_{k,l,a}(x) dx\n84\t    = integral sum_a (sum_b [A_i]_{a,b} [pi_n(x)]_{b,j})* (sum_c [A_k]_{a,c} [pi_n(x)]_{c,l}) dx\n85\t    = sum_{a,b,c} [A_i]_{a,b}* [A_k]_{a,c} integral [pi_n(x)]_{b,j}* [pi_n(x)]_{c,l} dx\n86\t\n87\t    For UNITARIZED pi_n: integral [pi_n_u]_{bj}* [pi_n_u]_{cl} dx = delta_{bc} delta_{jl} / (n+1)\n88\t\n89\t    So <f_{i,j}, f_{k,l}> = delta_{jl} / (n+1) * sum_a [A_i]_{a,j}* [A_k]_{a,j}\n90\t    Wait, that's not right. Let me redo:\n91\t    = sum_{a,b,c} [A_i*]_{a,b} [A_k]_{a,c} * delta_{bc} delta_{jl} / (n+1)\n92\t    = delta_{jl} / (n+1) * sum_{a,b} [A_i*]_{a,b} [A_k]_{a,b}\n93\t    = delta_{jl} / (n+1) * tr(A_i^H A_k)\n94\t\n95\t    Hmm, but that means the Gram in the (i,j) indices is:\n96\t    G_{(i,j),(k,l)} = delta_{jl} / (n+1) * tr(A_i^H A_k)\n97\t\n98\t    This is block-diagonal in j,l with the intertwiner overlap matrix\n99\t    H_{ik} = tr(A_i^H A_k) / (n+1) replicated (n+1) times.\n100\t\n101\t    Lowdin orthonormalization on this Gram makes the basis orthonormal.\n102\t    \"\"\"\n103\t    pass  # we compute it numerically via quadrature for safety\n104\t\n105\t\n106\tdef hopf_rule(D):\n107\t    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n108\t    Returns (nodes, weights) with weights normalized to sum to 1.\"\"\"\n109\t    K = D + 1\n110\t    nu = D // 2 + 1\n111\t    xs, ws = np.polynomial.legendre.leggauss(nu)\n112\t    u = (xs + 1) / 2\n113\t    wu = ws / 2\n114\t    xi = 2 * np.pi * np.arange(K) / K\n115\t    ce, se = np.sqrt(1 - u), np.sqrt(u)\n116\t    X, W = [], []\n117\t    for cu, su, w in zip(ce, se, wu):\n118\t        for a in xi:\n119\t            for b in xi:\n120\t                X.append([cu * np.cos(a), cu * np.sin(a),\n121\t                          su * np.cos(b), su * np.sin(b)])\n122\t                W.append(w)\n123\t    X = np.array(X)\n124\t    W = np.array(W)\n125\t    W /= W.sum()\n126\t    return X, W\n127\t\n128\t\n129\tdef eval_pi_n_unitary_at_nodes(n, nodes):\n130\t    \"\"\"Evaluate pi_n_unitary at each node. Returns array of shape (n_nodes, n+1, n+1).\"\"\"\n131\t    g = _sym_gram(n)\n132\t    Dh = np.diag(np.sqrt(g))\n133\t    Dih = np.diag(1.0 / np.sqrt(g))\n134\t    result = np.zeros((len(nodes), n + 1, n + 1), dtype=complex)\n135\t    for i, x in enumerate(nodes):\n136\t        M = quat_to_su2(np.asarray(x, float))\n137\t        result[i] = Dh @ sym_power(M, n) @ Dih\n138\t    return result\n139\t\n140\t\n141\tdef build_basis_object(rho, N_max):\n142\t    \"\"\"Build the § 3 basis object for sector rho at all levels n = 0..N_max.\n143\t\n144\t    Returns a dict: level n -> array of shape (total_modes_at_n, d_rho)\n145\t    where total_modes_at_n = mult(rho, n) * (n+1), representing the\n146\t    section coefficients in the unitarized harmonic basis.\n147\t\n148\t    The basis is Lowdin-orthonormalized and sign-fixed per § 3's construction.\n149\t    \"\"\"\n150\t    d_rho = DIMS[rho]\n151\t    basis = {}\n152\t\n153\t    for n in range(N_max + 1):\n154\t        m = multiplicity(rho, n)\n155\t        if m == 0:\n156\t            continue\n157\t        dim_n = n + 1\n158\t        total = m * dim_n\n159\t\n160\t        # compute intertwiners (shape: m x d_rho x dim_n)\n161\t        A = compute_intertwiners(rho, n)\n162\t        assert A.shape == (m, d_rho, dim_n)\n163\t\n164\t        # Gram matrix for the section basis:\n165\t        # G_{(i,j),(k,l)} = delta_{jl} * tr(A_i^H A_k) / (n+1)\n166\t        # This is block diagonal: for each j, the m x m block is H / (n+1)\n167\t        # where H_{ik} = tr(A_i^H A_k)\n168\t        H = np.zeros((m, m), dtype=complex)\n169\t        for i in range(m):\n170\t            for k in range(m):\n171\t                H[i, k] = np.trace(A[i].conj().T @ A[k])\n172\t        H /= (n + 1)\n173\t\n174\t        # Lowdin: B = H^{-1/2}, applied to each j-block independently\n175\t        # Since H is the same for all j, this simplifies\n176\t        H_half = sqrtm(H)\n177\t        try:\n178\t            B = np.linalg.inv(H_half)\n179\t        except np.linalg.LinAlgError:\n180\t            raise RuntimeError(f\"singular Gram at {rho}, n={n}\")\n181\t\n182\t        # orthonormalized intertwiners: A_orth = sum_k B_{ik} A_k\n183\t        A_orth = np.einsum('ik,kab->iab', B, A)\n184\t\n185\t        # verify orthonormality\n186\t        H_check = np.zeros((m, m), dtype=complex)\n187\t        for i in range(m):\n188\t            for k in range(m):\n189\t                H_check[i, k] = np.trace(A_orth[i].conj().T @ A_orth[k])\n190\t        H_check /= (n + 1)\n191\t        assert np.abs(H_check - np.eye(m)).max() < 1e-10, \\\n192\t            f\"Lowdin failed at {rho}, n={n}: {np.abs(H_check - np.eye(m)).max():.2e}\"\n193\t\n194\t        # sign fix each intertwiner\n195\t        for i in range(m):\n196\t            flat = A_orth[i].ravel()\n197\t            for c in flat:\n198\t                if abs(c) > 1e-14:\n199\t                    phase = c / abs(c)\n200\t                    A_orth[i] /= phase\n201\t                    break\n202\t\n203\t        basis[n] = A_orth  # shape (m, d_rho, dim_n)\n204\t\n205\t    return basis\n206\t\n207\t\n208\tdef basis_hash(basis_obj, rho):\n209\t    \"\"\"SHA-256 of the basis object's canonical serialization.\n210\t    Coefficients as little-endian float64 (real, imag) pairs in level-major,\n211\t    then intertwiner-index, then row, then column order.\"\"\"\n212\t    h = hashlib.sha256()\n213\t    for n in sorted(basis_obj.keys()):\n214\t        A = basis_obj[n]  # (m, d_rho, dim_n)\n215\t        for i in range(A.shape[0]):\n216\t            for r in range(A.shape[1]):\n217\t                for c in range(A.shape[2]):\n218\t                    z = A[i, r, c]\n219\t                    h.update(np.float64(z.real).tobytes())\n220\t                    h.update(np.float64(z.imag).tobytes())\n221\t    return h.hexdigest()\n222\t\n223\t\n224\tdef total_modes(rho, N):\n225\t    \"\"\"Total complex Galerkin modes in sector rho at cutoff N.\"\"\"\n226\t    return sum(multiplicity(rho, n) * (n + 1) for n in range(N + 1))\n227\t"}]},"uuid":"d7bf5e94-ca5c-47a7-bbdd-17e6a5270dbf","timestamp":"2026-08-30T17:32:45.737Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/sections.py","content":"\"\"\"Sector bases: intertwiner spaces Hom_2I(V_n, W_rho) and section bases for\nall sectors at all required levels.\n\nThe deterministic construction per § 3: stacked-constraint SVD over the\ngenerating pair, Lowdin orthonormalization against the per-level Gram, sign\nfixed by the first nonzero component.\n\nEach section f_{i,j}(x) = A_i * pi_n(x) * e_j takes values in W_rho,\nwhere A_i is d_rho x (n+1), pi_n(x) is the unitarized Sym^n at point x,\nand e_j is the j-th standard basis vector.\n\"\"\"\nimport numpy as np\nimport hashlib\nfrom scipy.linalg import sqrtm, svd as scipy_svd\nfrom build.group import (G120, GEN_INDICES, IRREP_NAMES, DIMS, D_RHO,\n                          multiplicity, pi_n_unitary, pi_n_mono, _sym_gram,\n                          rep_rho, ALL_REPS, qmul, quat_to_su2, sym_power)\n\n\ndef compute_intertwiners(rho, n):\n    \"\"\"Compute Hom_2I(V_n, W_rho) via stacked equivariance constraints\n    rho(g) A = A pi_n(g) over the generating pair, in the UNITARIZED basis.\n\n    Uses the CG-recurrence-based pi_n_unitary for numerical stability at all n.\n\n    Returns array of shape (mult, d_rho, n+1) in the UNITARIZED bases.\n    \"\"\"\n    d_rho = DIMS[rho]\n    dim_n = n + 1\n    if d_rho == 0 or dim_n == 0:\n        return np.zeros((0, 0, 0), dtype=complex)\n\n    m = multiplicity(rho, n)\n    if m == 0:\n        return np.zeros((0, d_rho, dim_n), dtype=complex)\n\n    vec_dim = d_rho * dim_n\n\n    rows = []\n    for gen_idx in GEN_INDICES:\n        rho_g = ALL_REPS[rho][gen_idx]\n        pi_g = pi_n_unitary(n, G120[gen_idx])\n        C = np.kron(np.eye(dim_n), rho_g) - np.kron(pi_g.T, np.eye(d_rho))\n        rows.append(C)\n    M = np.vstack(rows)\n\n    U, S, Vh = scipy_svd(M, full_matrices=True, lapack_driver='gesvd')\n    tol = max(1e-10 * S[0], 1e-12) if len(S) > 0 else 1e-12\n    null_mask = S < tol\n    n_null_from_sv = null_mask.sum()\n    n_trailing = max(0, Vh.shape[0] - len(S))\n    n_null = n_null_from_sv + n_trailing\n\n    assert n_null == m, f\"expected mult {m} for {rho} at n={n}, got nullity {n_null}\"\n\n    null_vecs = Vh[-n_null:]\n    # kron uses column-major vectorization: reshape accordingly\n    intertwiners = np.array([v.reshape(dim_n, d_rho).T for v in null_vecs])\n\n    # sign fix: first nonzero component has positive real part\n    for i in range(m):\n        flat = intertwiners[i].ravel()\n        for c in flat:\n            if abs(c) > 1e-14:\n                phase = c / abs(c)\n                intertwiners[i] /= phase\n                break\n\n    return intertwiners\n\n\ndef level_gram_analytic(n):\n    \"\"\"Per-level Gram matrix for sections in the UNITARIZED basis.\n\n    For the unitarized representation, Schur orthogonality gives:\n    integral pi_n_u(x)^H pi_n_u(x) dx = I / (n+1)\n\n    So for sections f_{i,j}(x) = A_i pi_n_u(x) e_j:\n    <f_{i,j}, f_{k,l}> = sum_alpha,b,c [A_i^H]_{b,alpha} [A_k]_{alpha,c} delta_{jl} / (n+1)\n    = delta_{jl} [A_i^H A_k]_{j...} ...\n\n    Actually, more carefully:\n    <f_{i,j}, f_{k,l}> = integral sum_a f_{i,j,a}(x)* f_{k,l,a}(x) dx\n    = integral sum_a (sum_b [A_i]_{a,b} [pi_n(x)]_{b,j})* (sum_c [A_k]_{a,c} [pi_n(x)]_{c,l}) dx\n    = sum_{a,b,c} [A_i]_{a,b}* [A_k]_{a,c} integral [pi_n(x)]_{b,j}* [pi_n(x)]_{c,l} dx\n\n    For UNITARIZED pi_n: integral [pi_n_u]_{bj}* [pi_n_u]_{cl} dx = delta_{bc} delta_{jl} / (n+1)\n\n    So <f_{i,j}, f_{k,l}> = delta_{jl} / (n+1) * sum_a [A_i]_{a,j}* [A_k]_{a,j}\n    Wait, that's not right. Let me redo:\n    = sum_{a,b,c} [A_i*]_{a,b} [A_k]_{a,c} * delta_{bc} delta_{jl} / (n+1)\n    = delta_{jl} / (n+1) * sum_{a,b} [A_i*]_{a,b} [A_k]_{a,b}\n    = delta_{jl} / (n+1) * tr(A_i^H A_k)\n\n    Hmm, but that means the Gram in the (i,j) indices is:\n    G_{(i,j),(k,l)} = delta_{jl} / (n+1) * tr(A_i^H A_k)\n\n    This is block-diagonal in j,l with the intertwiner overlap matrix\n    H_{ik} = tr(A_i^H A_k) / (n+1) replicated (n+1) times.\n\n    Lowdin orthonormalization on this Gram makes the basis orthonormal.\n    \"\"\"\n    pass  # we compute it numerically via quadrature for safety\n\n\ndef hopf_rule(D):\n    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n    Returns (nodes, weights) with weights normalized to sum to 1.\"\"\"\n    K = D + 1\n    nu = D // 2 + 1\n    xs, ws = np.polynomial.legendre.leggauss(nu)\n    u = (xs + 1) / 2\n    wu = ws / 2\n    xi = 2 * np.pi * np.arange(K) / K\n    ce, se = np.sqrt(1 - u), np.sqrt(u)\n    X, W = [], []\n    for cu, su, w in zip(ce, se, wu):\n        for a in xi:\n            for b in xi:\n                X.append([cu * np.cos(a), cu * np.sin(a),\n                          su * np.cos(b), su * np.sin(b)])\n                W.append(w)\n    X = np.array(X)\n    W = np.array(W)\n    W /= W.sum()\n    return X, W\n\n\ndef eval_pi_n_unitary_at_nodes(n, nodes):\n    \"\"\"Evaluate pi_n_unitary at each node. Returns array of shape (n_nodes, n+1, n+1).\"\"\"\n    g = _sym_gram(n)\n    Dh = np.diag(np.sqrt(g))\n    Dih = np.diag(1.0 / np.sqrt(g))\n    result = np.zeros((len(nodes), n + 1, n + 1), dtype=complex)\n    for i, x in enumerate(nodes):\n        M = quat_to_su2(np.asarray(x, float))\n        result[i] = Dh @ sym_power(M, n) @ Dih\n    return result\n\n\ndef build_basis_object(rho, N_max):\n    \"\"\"Build the § 3 basis object for sector rho at all levels n = 0..N_max.\n\n    Returns a dict: level n -> array of shape (total_modes_at_n, d_rho)\n    where total_modes_at_n = mult(rho, n) * (n+1), representing the\n    section coefficients in the unitarized harmonic basis.\n\n    The basis is Lowdin-orthonormalized and sign-fixed per § 3's construction.\n    \"\"\"\n    d_rho = DIMS[rho]\n    basis = {}\n\n    for n in range(N_max + 1):\n        m = multiplicity(rho, n)\n        if m == 0:\n            continue\n        dim_n = n + 1\n        total = m * dim_n\n\n        # compute intertwiners (shape: m x d_rho x dim_n)\n        A = compute_intertwiners(rho, n)\n        assert A.shape == (m, d_rho, dim_n)\n\n        # Gram matrix for the section basis:\n        # G_{(i,j),(k,l)} = delta_{jl} * tr(A_i^H A_k) / (n+1)\n        # This is block diagonal: for each j, the m x m block is H / (n+1)\n        # where H_{ik} = tr(A_i^H A_k)\n        H = np.zeros((m, m), dtype=complex)\n        for i in range(m):\n            for k in range(m):\n                H[i, k] = np.trace(A[i].conj().T @ A[k])\n        H /= (n + 1)\n\n        # Lowdin: B = H^{-1/2}, applied to each j-block independently\n        # Since H is the same for all j, this simplifies\n        H_half = sqrtm(H)\n        try:\n            B = np.linalg.inv(H_half)\n        except np.linalg.LinAlgError:\n            raise RuntimeError(f\"singular Gram at {rho}, n={n}\")\n\n        # orthonormalized intertwiners: A_orth = sum_k B_{ik} A_k\n        A_orth = np.einsum('ik,kab->iab', B, A)\n\n        # verify orthonormality\n        H_check = np.zeros((m, m), dtype=complex)\n        for i in range(m):\n            for k in range(m):\n                H_check[i, k] = np.trace(A_orth[i].conj().T @ A_orth[k])\n        H_check /= (n + 1)\n        assert np.abs(H_check - np.eye(m)).max() < 1e-10, \\\n            f\"Lowdin failed at {rho}, n={n}: {np.abs(H_check - np.eye(m)).max():.2e}\"\n\n        # sign fix each intertwiner\n        for i in range(m):\n            flat = A_orth[i].ravel()\n            for c in flat:\n                if abs(c) > 1e-14:\n                    phase = c / abs(c)\n                    A_orth[i] /= phase\n                    break\n\n        basis[n] = A_orth  # shape (m, d_rho, dim_n)\n\n    return basis\n\n\ndef basis_hash(basis_obj, rho):\n    \"\"\"SHA-256 of the basis object's canonical serialization.\n    Coefficients as little-endian float64 (real, imag) pairs in level-major,\n    then intertwiner-index, then row, then column order.\"\"\"\n    h = hashlib.sha256()\n    for n in sorted(basis_obj.keys()):\n        A = basis_obj[n]  # (m, d_rho, dim_n)\n        for i in range(A.shape[0]):\n            for r in range(A.shape[1]):\n                for c in range(A.shape[2]):\n                    z = A[i, r, c]\n                    h.update(np.float64(z.real).tobytes())\n                    h.update(np.float64(z.imag).tobytes())\n    return h.hexdigest()\n\n\ndef total_modes(rho, N):\n    \"\"\"Total complex Galerkin modes in sector rho at cutoff N.\"\"\"\n    return sum(multiplicity(rho, n) * (n + 1) for n in range(N + 1))\n","numLines":227,"startLine":1,"totalLines":227}},"sourceToolAssistantUUID":"943d8087-0a97-473c-b139-77ee11a0b1b9","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
