{"parentUuid":"597c74c4-5545-4e2b-8051-3c2133a2b189","isSidechain":true,"promptId":"e22f4082-815d-4291-8ec0-471a24337109","agentId":"a9164c81ffbd93f27","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W3pCPYhfEiXFhkw7QT9FZa","type":"tool_result","content":"1\t\"\"\"§ 10 arena-constructor registry.\n2\t\n3\tEvery arena identifier, its constructor, and the nonlinear-permitted flag.\n4\tThe registry keys on ARENA alone; the law is global c1=+1 with ONE named\n5\texception: § 7's control-(i) full-width wiring run under c1=0 on A-R0-N36.\n6\t\"\"\"\n7\t\n8\tAGREEMENT_RUNGS = [24, 32, 40, 48]\n9\tCONTROL_B_RUNGS = [36, 44, 52, 60]\n10\tALL_RUNGS = sorted(set(AGREEMENT_RUNGS + CONTROL_B_RUNGS))\n11\tNONTRIVIAL_SECTORS = ['R1', 'R2', 'R3', 'R4', 'R5', 'R6', 'R7', 'R8']\n12\t\n13\t\n14\tdef build_arena_registry():\n15\t    \"\"\"Build the § 10 arena-constructor registry as a list of dicts.\"\"\"\n16\t    registry = []\n17\t\n18\t    for N in ALL_RUNGS:\n19\t        registry.append({\n20\t            'id': f'A-R0-N{N}',\n21\t            'arena': f'E_R0 retained space at cutoff N={N}',\n22\t            'nonlinear_permitted': True,\n23\t            'constructor': f'R0 section basis levels 0..{N}, Galerkin projector P_N^R0',\n24\t        })\n25\t\n26\t    for N in ALL_RUNGS:\n27\t        registry.append({\n28\t            'id': f'A-R0C2-N{N}',\n29\t            'arena': f'E_R0 ⊗ C² manufactured extension at cutoff N={N}',\n30\t            'nonlinear_permitted': True,\n31\t            'constructor': f'R0 section basis levels 0..{N} tensored with C², projector P_N^R0 ⊗ I_2',\n32\t        })\n33\t\n34\t    registry.append({\n35\t        'id': 'A-CTRLA',\n36\t        'arena': 'Control A two-level full-S³ arena (levels 2 and 6), § 6',\n37\t        'nonlinear_permitted': True,\n38\t        'constructor': 'full-S³ scalar harmonics at levels {2, 6}, manufactured projector P_{2,6}',\n39\t    })\n40\t\n41\t    registry.append({\n42\t        'id': 'A-CTRLI',\n43\t        'arena': 'control (i) c1=0 linear operator on H_{R0,12}, § 7',\n44\t        'nonlinear_permitted': True,\n45\t        'constructor': 'H_{R0,12} ≅ V_12^* (R0 level 12, dim 13), linear law c1=0',\n46\t    })\n47\t\n48\t    for rho in NONTRIVIAL_SECTORS:\n49\t        for N in ALL_RUNGS:\n50\t            registry.append({\n51\t                'id': f'A-SECTOR-{rho}-N{N}',\n52\t                'arena': f'nontrivial W_{rho}-valued bases and projectors at N={N}',\n53\t                'nonlinear_permitted': False,\n54\t                'constructor': f'{rho} section basis levels 0..{N}, linear operations only',\n55\t            })\n56\t\n57\t    return registry\n58\t"}]},"uuid":"e26cc9c7-a988-4363-9502-27ca86e823a8","timestamp":"2026-08-30T17:39:24.941Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/arena.py","content":"\"\"\"§ 10 arena-constructor registry.\n\nEvery arena identifier, its constructor, and the nonlinear-permitted flag.\nThe registry keys on ARENA alone; the law is global c1=+1 with ONE named\nexception: § 7's control-(i) full-width wiring run under c1=0 on A-R0-N36.\n\"\"\"\n\nAGREEMENT_RUNGS = [24, 32, 40, 48]\nCONTROL_B_RUNGS = [36, 44, 52, 60]\nALL_RUNGS = sorted(set(AGREEMENT_RUNGS + CONTROL_B_RUNGS))\nNONTRIVIAL_SECTORS = ['R1', 'R2', 'R3', 'R4', 'R5', 'R6', 'R7', 'R8']\n\n\ndef build_arena_registry():\n    \"\"\"Build the § 10 arena-constructor registry as a list of dicts.\"\"\"\n    registry = []\n\n    for N in ALL_RUNGS:\n        registry.append({\n            'id': f'A-R0-N{N}',\n            'arena': f'E_R0 retained space at cutoff N={N}',\n            'nonlinear_permitted': True,\n            'constructor': f'R0 section basis levels 0..{N}, Galerkin projector P_N^R0',\n        })\n\n    for N in ALL_RUNGS:\n        registry.append({\n            'id': f'A-R0C2-N{N}',\n            'arena': f'E_R0 ⊗ C² manufactured extension at cutoff N={N}',\n            'nonlinear_permitted': True,\n            'constructor': f'R0 section basis levels 0..{N} tensored with C², projector P_N^R0 ⊗ I_2',\n        })\n\n    registry.append({\n        'id': 'A-CTRLA',\n        'arena': 'Control A two-level full-S³ arena (levels 2 and 6), § 6',\n        'nonlinear_permitted': True,\n        'constructor': 'full-S³ scalar harmonics at levels {2, 6}, manufactured projector P_{2,6}',\n    })\n\n    registry.append({\n        'id': 'A-CTRLI',\n        'arena': 'control (i) c1=0 linear operator on H_{R0,12}, § 7',\n        'nonlinear_permitted': True,\n        'constructor': 'H_{R0,12} ≅ V_12^* (R0 level 12, dim 13), linear law c1=0',\n    })\n\n    for rho in NONTRIVIAL_SECTORS:\n        for N in ALL_RUNGS:\n            registry.append({\n                'id': f'A-SECTOR-{rho}-N{N}',\n                'arena': f'nontrivial W_{rho}-valued bases and projectors at N={N}',\n                'nonlinear_permitted': False,\n                'constructor': f'{rho} section basis levels 0..{N}, linear operations only',\n            })\n\n    return registry\n","numLines":58,"startLine":1,"totalLines":58}},"sourceToolAssistantUUID":"597c74c4-5545-4e2b-8051-3c2133a2b189","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
{"parentUuid":"ce62300f-2cb1-4f0c-ad01-956d1828a5d3","isSidechain":true,"promptId":"e22f4082-815d-4291-8ec0-471a24337109","agentId":"a9164c81ffbd93f27","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NbSuzUz6CnisVpGLtZhsA3","type":"tool_result","content":"1\t\"\"\"Output ledger utilities: append-only JSON records per § 13.\"\"\"\n2\timport json\n3\timport time\n4\timport os\n5\t\n6\tLEDGER_PATH = 'ledger/OUTPUT_LEDGER.jsonl'\n7\t\n8\t_start_time = None\n9\t_cumulative_seconds = 0.0\n10\t\n11\t\n12\tdef init_clock():\n13\t    global _start_time\n14\t    _start_time = time.time()\n15\t\n16\t\n17\tdef _wall_since_init():\n18\t    if _start_time is None:\n19\t        return 0.0\n20\t    return time.time() - _start_time\n21\t\n22\t\n23\tdef append_record(record):\n24\t    \"\"\"Append one JSON record to the output ledger.\"\"\"\n25\t    with open(LEDGER_PATH, 'a') as f:\n26\t        f.write(json.dumps(record, ensure_ascii=False) + '\\n')\n27\t\n28\t\n29\tdef gate_record(gate_id, arena_id, rung, parent_status, mutation_status,\n30\t                measured_values, wall_clock_seconds, law_exception=False,\n31\t                **extra):\n32\t    \"\"\"Write a GATE record per § 13.\"\"\"\n33\t    global _cumulative_seconds\n34\t    _cumulative_seconds += wall_clock_seconds\n35\t    rec = {\n36\t        'type': 'GATE',\n37\t        'gate_id': gate_id,\n38\t        'arena_id': arena_id,\n39\t        'rung': rung,\n40\t        'parent_status': parent_status,\n41\t        'mutation_status': mutation_status,\n42\t        'measured_values': measured_values,\n43\t        'law_exception': law_exception,\n44\t        'wall_clock_seconds': round(wall_clock_seconds, 3),\n45\t        'cumulative_seconds': round(_cumulative_seconds, 3),\n46\t    }\n47\t    rec.update(extra)\n48\t    append_record(rec)\n49\t    return rec\n50\t\n51\t\n52\tdef resource_record(gate_id, wall_clock_seconds):\n53\t    \"\"\"Write a RESOURCE record per § 13.\"\"\"\n54\t    global _cumulative_seconds\n55\t    _cumulative_seconds += wall_clock_seconds\n56\t    rec = {\n57\t        'type': 'RESOURCE',\n58\t        'gate_id': gate_id,\n59\t        'wall_clock_seconds': round(wall_clock_seconds, 3),\n60\t        'cumulative_seconds': round(_cumulative_seconds, 3),\n61\t    }\n62\t    append_record(rec)\n63\t    return rec\n64\t\n65\t\n66\tdef arm_allocation_record(allocations):\n67\t    \"\"\"Write an ARM-ALLOCATION record per § 13.\"\"\"\n68\t    rec = {\n69\t        'type': 'ARM-ALLOCATION',\n70\t        'allocations': allocations,\n71\t    }\n72\t    append_record(rec)\n73\t    return rec\n74\t\n75\t\n76\tdef disposition_record(disposition_type, **fields):\n77\t    \"\"\"Write a DISPOSITION record per § 13.\"\"\"\n78\t    rec = {'type': 'DISPOSITION', 'disposition': disposition_type}\n79\t    rec.update(fields)\n80\t    append_record(rec)\n81\t    return rec\n82\t\n83\t\n84\tdef coverage_record(registry_coverage, prohibited_check):\n85\t    \"\"\"Write a COVERAGE record for gate 10.\"\"\"\n86\t    rec = {\n87\t        'type': 'COVERAGE',\n88\t        'registry_coverage': registry_coverage,\n89\t        'prohibited_check': prohibited_check,\n90\t    }\n91\t    append_record(rec)\n92\t    return rec\n93\t"}]},"uuid":"af948eb7-bd0d-4985-8773-50512a51f4c3","timestamp":"2026-08-30T17:39:24.942Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/ledger_util.py","content":"\"\"\"Output ledger utilities: append-only JSON records per § 13.\"\"\"\nimport json\nimport time\nimport os\n\nLEDGER_PATH = 'ledger/OUTPUT_LEDGER.jsonl'\n\n_start_time = None\n_cumulative_seconds = 0.0\n\n\ndef init_clock():\n    global _start_time\n    _start_time = time.time()\n\n\ndef _wall_since_init():\n    if _start_time is None:\n        return 0.0\n    return time.time() - _start_time\n\n\ndef append_record(record):\n    \"\"\"Append one JSON record to the output ledger.\"\"\"\n    with open(LEDGER_PATH, 'a') as f:\n        f.write(json.dumps(record, ensure_ascii=False) + '\\n')\n\n\ndef gate_record(gate_id, arena_id, rung, parent_status, mutation_status,\n                measured_values, wall_clock_seconds, law_exception=False,\n                **extra):\n    \"\"\"Write a GATE record per § 13.\"\"\"\n    global _cumulative_seconds\n    _cumulative_seconds += wall_clock_seconds\n    rec = {\n        'type': 'GATE',\n        'gate_id': gate_id,\n        'arena_id': arena_id,\n        'rung': rung,\n        'parent_status': parent_status,\n        'mutation_status': mutation_status,\n        'measured_values': measured_values,\n        'law_exception': law_exception,\n        'wall_clock_seconds': round(wall_clock_seconds, 3),\n        'cumulative_seconds': round(_cumulative_seconds, 3),\n    }\n    rec.update(extra)\n    append_record(rec)\n    return rec\n\n\ndef resource_record(gate_id, wall_clock_seconds):\n    \"\"\"Write a RESOURCE record per § 13.\"\"\"\n    global _cumulative_seconds\n    _cumulative_seconds += wall_clock_seconds\n    rec = {\n        'type': 'RESOURCE',\n        'gate_id': gate_id,\n        'wall_clock_seconds': round(wall_clock_seconds, 3),\n        'cumulative_seconds': round(_cumulative_seconds, 3),\n    }\n    append_record(rec)\n    return rec\n\n\ndef arm_allocation_record(allocations):\n    \"\"\"Write an ARM-ALLOCATION record per § 13.\"\"\"\n    rec = {\n        'type': 'ARM-ALLOCATION',\n        'allocations': allocations,\n    }\n    append_record(rec)\n    return rec\n\n\ndef disposition_record(disposition_type, **fields):\n    \"\"\"Write a DISPOSITION record per § 13.\"\"\"\n    rec = {'type': 'DISPOSITION', 'disposition': disposition_type}\n    rec.update(fields)\n    append_record(rec)\n    return rec\n\n\ndef coverage_record(registry_coverage, prohibited_check):\n    \"\"\"Write a COVERAGE record for gate 10.\"\"\"\n    rec = {\n        'type': 'COVERAGE',\n        'registry_coverage': registry_coverage,\n        'prohibited_check': prohibited_check,\n    }\n    append_record(rec)\n    return rec\n","numLines":93,"startLine":1,"totalLines":93}},"sourceToolAssistantUUID":"ce62300f-2cb1-4f0c-ad01-956d1828a5d3","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
{"parentUuid":"af948eb7-bd0d-4985-8773-50512a51f4c3","isSidechain":true,"agentId":"a9164c81ffbd93f27","message":{"model":"claude-opus-4-6","id":"msg_011CeZLn9LYCM5ZyWM3htag4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Tv2UK3cnV3LfL5VJNoeHi7","name":"Read","input":{"file_path":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/quadrature.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":4802,"cache_read_input_tokens":16388,"cache_creation":{"ephemeral_5m_input_tokens":4802,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null},"requestId":"req_011CeZLn8XvXci1toJRdXAUZ","attributionAgent":"general-purpose","type":"assistant","uuid":"0966e574-4e30-4c24-9a2d-eec231a2cc51","timestamp":"2026-08-30T17:39:25.343Z","effort":"high","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
{"parentUuid":"0966e574-4e30-4c24-9a2d-eec231a2cc51","isSidechain":true,"promptId":"e22f4082-815d-4291-8ec0-471a24337109","agentId":"a9164c81ffbd93f27","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tv2UK3cnV3LfL5VJNoeHi7","type":"tool_result","content":"1\t\"\"\"Hopf-coordinate quadrature on S^3 for spectral Galerkin methods.\n2\t\n3\tProduct rules on S^3 using Hopf coordinates:\n4\t    x = (cos eta cos xi1, cos eta sin xi1, sin eta cos xi2, sin eta sin xi2)\n5\twith measure proportional to cos(eta) sin(eta) d(eta) d(xi1) d(xi2).\n6\tThe substitution u = sin^2(eta) linearizes the radial part.\n7\t\n8\tQuadrature nodes and weights, plus direct (non-FFT) synthesis and analysis\n9\ttransforms for equivariant section bases.\n10\t\"\"\"\n11\t\n12\timport numpy as np\n13\tfrom build.group import pi_n_unitary, quat_to_su2, _sym_gram, DIMS, multiplicity\n14\t\n15\t\n16\t# ---------------------------------------------------------------------------\n17\t# Quadrature rules\n18\t# ---------------------------------------------------------------------------\n19\t\n20\tdef hopf_rule(D):\n21\t    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n22\t\n23\t    Parameters\n24\t    ----------\n25\t    D : int\n26\t        Maximum polynomial degree for which the rule is exact.\n27\t\n28\t    Returns\n29\t    -------\n30\t    nodes : ndarray, shape (N_nodes, 4)\n31\t        Points on S^3 in Cartesian coordinates.\n32\t    weights : ndarray, shape (N_nodes,)\n33\t        Quadrature weights, normalized so that weights.sum() == 1.\n34\t\n35\t    Notes\n36\t    -----\n37\t    The rule uses:\n38\t    - K = D+1 uniform points in each of xi1, xi2 in [0, 2*pi)\n39\t      (exact for trigonometric polynomials of degree <= D via the DFT).\n40\t    - nu = D//2 + 1 Gauss-Legendre points in u = sin^2(eta) in [0, 1]\n41\t      (exact for polynomials of degree <= 2*nu - 1 >= D in u;\n42\t       the change of variables from eta to u absorbs the cos(eta)*sin(eta)\n43\t       Jacobian, so the u-integrand is a polynomial of degree <= D//2 in u\n44\t       when the angular part has been eliminated by the trapezoidal rule).\n45\t\n46\t    Node count = nu * K^2.\n47\t    \"\"\"\n48\t    K = D + 1\n49\t    nu = D // 2 + 1\n50\t\n51\t    # Gauss-Legendre on [-1, 1], mapped to u in [0, 1]\n52\t    xs, ws = np.polynomial.legendre.leggauss(nu)\n53\t    u = (xs + 1) / 2\n54\t    wu = ws / 2\n55\t\n56\t    # Uniform grid in each angle\n57\t    xi = 2 * np.pi * np.arange(K) / K\n58\t\n59\t    # Precompute cos(eta), sin(eta) from u = sin^2(eta)\n60\t    ce = np.sqrt(1 - u)   # cos(eta)\n61\t    se = np.sqrt(u)        # sin(eta)\n62\t\n63\t    # Build node array and weight array\n64\t    n_nodes = nu * K * K\n65\t    nodes = np.empty((n_nodes, 4))\n66\t    weights = np.empty(n_nodes)\n67\t\n68\t    idx = 0\n69\t    for i_u in range(nu):\n70\t        c, s, w = ce[i_u], se[i_u], wu[i_u]\n71\t        for i_a in range(K):\n72\t            ca, sa = np.cos(xi[i_a]), np.sin(xi[i_a])\n73\t            for i_b in range(K):\n74\t                cb, sb = np.cos(xi[i_b]), np.sin(xi[i_b])\n75\t                nodes[idx, 0] = c * ca\n76\t                nodes[idx, 1] = c * sa\n77\t                nodes[idx, 2] = s * cb\n78\t                nodes[idx, 3] = s * sb\n79\t                weights[idx] = w\n80\t                idx += 1\n81\t\n82\t    weights /= weights.sum()\n83\t    return nodes, weights\n84\t\n85\t\n86\tdef production_rule(N):\n87\t    \"\"\"4N-exact Hopf rule for Galerkin production integrands at band limit N.\n88\t\n89\t    The cubic nonlinearity |psi|^2 psi with psi band-limited to level N\n90\t    produces integrands of polynomial degree <= 4N when projected onto\n91\t    modes of degree <= N.\n92\t\n93\t    Node count: nu * K^2 where K = 4N+1, nu = 2N+1.\n94\t    So node count = (2N+1) * (4N+1)^2.\n95\t\n96\t    Parameters\n97\t    ----------\n98\t    N : int\n99\t        Band limit of the field.\n100\t\n101\t    Returns\n102\t    -------\n103\t    nodes : ndarray, shape (N_nodes, 4)\n104\t    weights : ndarray, shape (N_nodes,)\n105\t    \"\"\"\n106\t    return hopf_rule(4 * N)\n107\t\n108\t\n109\tdef monitor_rule(N):\n110\t    \"\"\"6N-exact Hopf rule for cascade-monitor integrands at band limit N.\n111\t\n112\t    The cascade monitor measures the band N < n <= 3N of |psi|^2 psi.\n113\t    Projecting onto modes of degree up to 3N against a degree-3N integrand\n114\t    requires exactness to degree 6N.\n115\t\n116\t    Node count: nu * K^2 where K = 6N+1, nu = 3N+1.\n117\t    So node count = (3N+1) * (6N+1)^2.\n118\t\n119\t    Parameters\n120\t    ----------\n121\t    N : int\n122\t        Band limit of the field.\n123\t\n124\t    Returns\n125\t    -------\n126\t    nodes : ndarray, shape (N_nodes, 4)\n127\t    weights : ndarray, shape (N_nodes,)\n128\t    \"\"\"\n129\t    return hopf_rule(6 * N)\n130\t\n131\t\n132\t# ---------------------------------------------------------------------------\n133\t# Representation evaluation at nodes\n134\t# ---------------------------------------------------------------------------\n135\t\n136\tdef eval_pi_n_unitary_at_nodes(n, nodes):\n137\t    \"\"\"Evaluate the unitarized n-th symmetric power at each quadrature node.\n138\t\n139\t    Parameters\n140\t    ----------\n141\t    n : int\n142\t        Representation level (dimension = n+1).\n143\t    nodes : ndarray, shape (N_nodes, 4)\n144\t        Points on S^3 (unit quaternions).\n145\t\n146\t    Returns\n147\t    -------\n148\t    pi_vals : ndarray, shape (N_nodes, n+1, n+1), dtype complex\n149\t        pi_vals[i] = pi_n_unitary(n, nodes[i]).\n150\t    \"\"\"\n151\t    if n == 0:\n152\t        return np.ones((len(nodes), 1, 1), dtype=complex)\n153\t\n154\t    n_nodes = len(nodes)\n155\t    dim = n + 1\n156\t    result = np.empty((n_nodes, dim, dim), dtype=complex)\n157\t\n158\t    for i in range(n_nodes):\n159\t        result[i] = pi_n_unitary(n, nodes[i])\n160\t\n161\t    return result\n162\t\n163\t\n164\t# ---------------------------------------------------------------------------\n165\t# Section evaluation\n166\t# ---------------------------------------------------------------------------\n167\t\n168\tdef eval_section_at_nodes(intertwiner, n, nodes, pi_cache=None):\n169\t    \"\"\"Evaluate one intertwiner's section basis functions at quadrature nodes.\n170\t\n171\t    For intertwiner A of shape (d_rho, n+1), the section basis functions are:\n172\t        f_{A,j}(x) = A . pi_n_unitary(x) . e_j    for j = 0, ..., n\n173\t\n174\t    giving a d_rho-valued function for each j.\n175\t\n176\t    Parameters\n177\t    ----------\n178\t    intertwiner : ndarray, shape (d_rho, n+1)\n179\t        The intertwiner matrix A.\n180\t    n : int\n181\t        Representation level.\n182\t    nodes : ndarray, shape (N_nodes, 4)\n183\t        Quadrature nodes on S^3.\n184\t    pi_cache : ndarray, shape (N_nodes, n+1, n+1) or None\n185\t        Precomputed pi_n_unitary values. If None, they are computed here.\n186\t\n187\t    Returns\n188\t    -------\n189\t    values : ndarray, shape (N_nodes, d_rho, n+1)\n190\t        values[i, a, j] = sum_b A[a,b] * pi_n_unitary(nodes[i])[b,j].\n191\t    \"\"\"\n192\t    if pi_cache is None:\n193\t        pi_cache = eval_pi_n_unitary_at_nodes(n, nodes)\n194\t\n195\t    # intertwiner is (d_rho, dim_n), pi_cache is (N_nodes, dim_n, dim_n)\n196\t    # result[i] = A @ pi_cache[i], shape (d_rho, dim_n)\n197\t    # Use einsum: result[i, a, j] = sum_b A[a,b] * pi_cache[i,b,j]\n198\t    values = np.einsum('ab,ibj->iaj', intertwiner, pi_cache)\n199\t    return values\n200\t\n201\t\n202\t# ---------------------------------------------------------------------------\n203\t# Direct synthesis (coefficients -> field values at nodes)\n204\t# ---------------------------------------------------------------------------\n205\t\n206\tdef synthesis(coefficients, basis_obj, nodes, rho=None):\n207\t    \"\"\"Evaluate an equivariant field at quadrature nodes from Galerkin coefficients.\n208\t\n209\t    The field is:\n210\t        psi(x) = sum_{n} sum_{i=0}^{m_n-1} sum_{j=0}^{n}\n211\t                     c_{n,i,j} * A_{n,i} . pi_n(x) . e_j\n212\t\n213\t    where A_{n,i} are the orthonormalized intertwiners from basis_obj.\n214\t\n215\t    Parameters\n216\t    ----------\n217\t    coefficients : ndarray, shape (N_total,) complex\n218\t        Galerkin coefficients in level-major, intertwiner-index, then j order.\n219\t        N_total = sum over active levels of mult(rho, n) * (n+1).\n220\t    basis_obj : dict\n221\t        level n -> ndarray of shape (mult, d_rho, n+1), the orthonormalized\n222\t        intertwiners. Produced by sections.build_basis_object().\n223\t    nodes : ndarray, shape (N_nodes, 4)\n224\t        Quadrature nodes on S^3.\n225\t    rho : str or None\n226\t        Sector name (for extracting d_rho). If None, inferred from basis_obj.\n227\t\n228\t    Returns\n229\t    -------\n230\t    field : ndarray, shape (N_nodes, d_rho), dtype complex\n231\t        The field evaluated at each node.\n232\t    \"\"\"\n233\t    # Determine d_rho from the first available level\n234\t    levels = sorted(basis_obj.keys())\n235\t    if len(levels) == 0:\n236\t        raise ValueError(\"empty basis_obj\")\n237\t    d_rho = basis_obj[levels[0]].shape[1]\n238\t\n239\t    n_nodes = len(nodes)\n240\t    field = np.zeros((n_nodes, d_rho), dtype=complex)\n241\t\n242\t    # Walk through coefficients level by level\n243\t    offset = 0\n244\t    for n in levels:\n245\t        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n246\t        m = A_all.shape[0]\n247\t        dim_n = n + 1\n248\t        block_size = m * dim_n\n249\t\n250\t        # Extract this level's coefficients: shape (m, dim_n)\n251\t        c_block = coefficients[offset:offset + block_size].reshape(m, dim_n)\n252\t        offset += block_size\n253\t\n254\t        # Compute pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n255\t        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n256\t\n257\t        # For each intertwiner i and column j:\n258\t        #   contribution = c_{n,i,j} * A_{n,i} @ pi_n(x) @ e_j\n259\t        # Vectorized: for intertwiner i,\n260\t        #   A_i @ pi_vals[node] has shape (d_rho, dim_n)\n261\t        #   sum over j of c[i,j] * (A_i @ pi_vals)[node, :, j]\n262\t        #     = A_i @ pi_vals[node] @ c[i, :]\n263\t\n264\t        # section_vals[i, node, :] = A_i @ pi_vals[node] @ c[i, :]\n265\t        for i in range(m):\n266\t            # A_all[i] @ pi_vals: shape (N_nodes, d_rho, dim_n)\n267\t            Apn = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n268\t            # Contract with c_block[i]: (N_nodes, d_rho)\n269\t            field += np.einsum('naj,j->na', Apn, c_block[i])\n270\t\n271\t    return field\n272\t\n273\t\n274\t# ---------------------------------------------------------------------------\n275\t# Direct analysis (field values at nodes -> coefficients)\n276\t# ---------------------------------------------------------------------------\n277\t\n278\tdef analysis(field_values, basis_obj, nodes, weights):\n279\t    \"\"\"Compute Galerkin coefficients from field values at quadrature nodes.\n280\t\n281\t    This is the quadrature-weighted adjoint of synthesis:\n282\t        c_{n,i,j} = sum_nodes w_node * f_{n,i,j}(x_node)^H . psi(x_node)\n283\t\n284\t    where f_{n,i,j}(x) = A_{n,i} . pi_n(x) . e_j is the section basis function.\n285\t\n286\t    For orthonormal sections and an exact-enough rule, analysis(synthesis(c)) = c.\n287\t\n288\t    Parameters\n289\t    ----------\n290\t    field_values : ndarray, shape (N_nodes, d_rho), dtype complex\n291\t        The field evaluated at each node.\n292\t    basis_obj : dict\n293\t        level n -> ndarray of shape (mult, d_rho, n+1).\n294\t    nodes : ndarray, shape (N_nodes, 4)\n295\t        Quadrature nodes on S^3.\n296\t    weights : ndarray, shape (N_nodes,)\n297\t        Quadrature weights (summing to 1).\n298\t\n299\t    Returns\n300\t    -------\n301\t    coefficients : ndarray, shape (N_total,), dtype complex\n302\t        Galerkin coefficients in level-major order.\n303\t    \"\"\"\n304\t    levels = sorted(basis_obj.keys())\n305\t    if len(levels) == 0:\n306\t        raise ValueError(\"empty basis_obj\")\n307\t\n308\t    # Weighted field values: shape (N_nodes, d_rho)\n309\t    weighted_field = weights[:, None] * field_values\n310\t\n311\t    coeffs_list = []\n312\t\n313\t    for n in levels:\n314\t        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n315\t        m = A_all.shape[0]\n316\t        dim_n = n + 1\n317\t\n318\t        # pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n319\t        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n320\t\n321\t        c_block = np.zeros((m, dim_n), dtype=complex)\n322\t\n323\t        for i in range(m):\n324\t            # Section basis values: f_{i,j}(x)[a] = sum_b A[a,b] pi[b,j]\n325\t            # f_vals shape: (N_nodes, d_rho, dim_n)\n326\t            f_vals = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n327\t\n328\t            # Inner product: c[i,j] = sum_node sum_a w[node] * f[node,a,j]^* * psi[node,a]\n329\t            # = sum_node sum_a f_vals[node,a,j]^* * weighted_field[node,a]\n330\t            c_block[i] = np.einsum('naj,na->j', f_vals.conj(), weighted_field)\n331\t\n332\t        # No normalization factor needed: the Lowdin-orthonormalized\n333\t        # intertwiners satisfy tr(A_i^H A_k) / (n+1) = delta_{ik},\n334\t        # which combined with Schur orthogonality (integral of\n335\t        # pi[b,j]^* pi[c,l] = delta_{bc} delta_{jl} / (n+1)) gives\n336\t        # orthonormal sections: <f_{i,j}, f_{k,l}> = delta_{ik} delta_{jl}.\n337\t\n338\t        coeffs_list.append(c_block.ravel())\n339\t\n340\t    return np.concatenate(coeffs_list)\n341\t"}]},"uuid":"91e140e6-c15e-4174-b5b0-9f117dbec0cc","timestamp":"2026-08-30T17:39:25.349Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD/build/quadrature.py","content":"\"\"\"Hopf-coordinate quadrature on S^3 for spectral Galerkin methods.\n\nProduct rules on S^3 using Hopf coordinates:\n    x = (cos eta cos xi1, cos eta sin xi1, sin eta cos xi2, sin eta sin xi2)\nwith measure proportional to cos(eta) sin(eta) d(eta) d(xi1) d(xi2).\nThe substitution u = sin^2(eta) linearizes the radial part.\n\nQuadrature nodes and weights, plus direct (non-FFT) synthesis and analysis\ntransforms for equivariant section bases.\n\"\"\"\n\nimport numpy as np\nfrom build.group import pi_n_unitary, quat_to_su2, _sym_gram, DIMS, multiplicity\n\n\n# ---------------------------------------------------------------------------\n# Quadrature rules\n# ---------------------------------------------------------------------------\n\ndef hopf_rule(D):\n    \"\"\"Hopf-coordinate product rule exact for polynomials of degree <= D on S^3.\n\n    Parameters\n    ----------\n    D : int\n        Maximum polynomial degree for which the rule is exact.\n\n    Returns\n    -------\n    nodes : ndarray, shape (N_nodes, 4)\n        Points on S^3 in Cartesian coordinates.\n    weights : ndarray, shape (N_nodes,)\n        Quadrature weights, normalized so that weights.sum() == 1.\n\n    Notes\n    -----\n    The rule uses:\n    - K = D+1 uniform points in each of xi1, xi2 in [0, 2*pi)\n      (exact for trigonometric polynomials of degree <= D via the DFT).\n    - nu = D//2 + 1 Gauss-Legendre points in u = sin^2(eta) in [0, 1]\n      (exact for polynomials of degree <= 2*nu - 1 >= D in u;\n       the change of variables from eta to u absorbs the cos(eta)*sin(eta)\n       Jacobian, so the u-integrand is a polynomial of degree <= D//2 in u\n       when the angular part has been eliminated by the trapezoidal rule).\n\n    Node count = nu * K^2.\n    \"\"\"\n    K = D + 1\n    nu = D // 2 + 1\n\n    # Gauss-Legendre on [-1, 1], mapped to u in [0, 1]\n    xs, ws = np.polynomial.legendre.leggauss(nu)\n    u = (xs + 1) / 2\n    wu = ws / 2\n\n    # Uniform grid in each angle\n    xi = 2 * np.pi * np.arange(K) / K\n\n    # Precompute cos(eta), sin(eta) from u = sin^2(eta)\n    ce = np.sqrt(1 - u)   # cos(eta)\n    se = np.sqrt(u)        # sin(eta)\n\n    # Build node array and weight array\n    n_nodes = nu * K * K\n    nodes = np.empty((n_nodes, 4))\n    weights = np.empty(n_nodes)\n\n    idx = 0\n    for i_u in range(nu):\n        c, s, w = ce[i_u], se[i_u], wu[i_u]\n        for i_a in range(K):\n            ca, sa = np.cos(xi[i_a]), np.sin(xi[i_a])\n            for i_b in range(K):\n                cb, sb = np.cos(xi[i_b]), np.sin(xi[i_b])\n                nodes[idx, 0] = c * ca\n                nodes[idx, 1] = c * sa\n                nodes[idx, 2] = s * cb\n                nodes[idx, 3] = s * sb\n                weights[idx] = w\n                idx += 1\n\n    weights /= weights.sum()\n    return nodes, weights\n\n\ndef production_rule(N):\n    \"\"\"4N-exact Hopf rule for Galerkin production integrands at band limit N.\n\n    The cubic nonlinearity |psi|^2 psi with psi band-limited to level N\n    produces integrands of polynomial degree <= 4N when projected onto\n    modes of degree <= N.\n\n    Node count: nu * K^2 where K = 4N+1, nu = 2N+1.\n    So node count = (2N+1) * (4N+1)^2.\n\n    Parameters\n    ----------\n    N : int\n        Band limit of the field.\n\n    Returns\n    -------\n    nodes : ndarray, shape (N_nodes, 4)\n    weights : ndarray, shape (N_nodes,)\n    \"\"\"\n    return hopf_rule(4 * N)\n\n\ndef monitor_rule(N):\n    \"\"\"6N-exact Hopf rule for cascade-monitor integrands at band limit N.\n\n    The cascade monitor measures the band N < n <= 3N of |psi|^2 psi.\n    Projecting onto modes of degree up to 3N against a degree-3N integrand\n    requires exactness to degree 6N.\n\n    Node count: nu * K^2 where K = 6N+1, nu = 3N+1.\n    So node count = (3N+1) * (6N+1)^2.\n\n    Parameters\n    ----------\n    N : int\n        Band limit of the field.\n\n    Returns\n    -------\n    nodes : ndarray, shape (N_nodes, 4)\n    weights : ndarray, shape (N_nodes,)\n    \"\"\"\n    return hopf_rule(6 * N)\n\n\n# ---------------------------------------------------------------------------\n# Representation evaluation at nodes\n# ---------------------------------------------------------------------------\n\ndef eval_pi_n_unitary_at_nodes(n, nodes):\n    \"\"\"Evaluate the unitarized n-th symmetric power at each quadrature node.\n\n    Parameters\n    ----------\n    n : int\n        Representation level (dimension = n+1).\n    nodes : ndarray, shape (N_nodes, 4)\n        Points on S^3 (unit quaternions).\n\n    Returns\n    -------\n    pi_vals : ndarray, shape (N_nodes, n+1, n+1), dtype complex\n        pi_vals[i] = pi_n_unitary(n, nodes[i]).\n    \"\"\"\n    if n == 0:\n        return np.ones((len(nodes), 1, 1), dtype=complex)\n\n    n_nodes = len(nodes)\n    dim = n + 1\n    result = np.empty((n_nodes, dim, dim), dtype=complex)\n\n    for i in range(n_nodes):\n        result[i] = pi_n_unitary(n, nodes[i])\n\n    return result\n\n\n# ---------------------------------------------------------------------------\n# Section evaluation\n# ---------------------------------------------------------------------------\n\ndef eval_section_at_nodes(intertwiner, n, nodes, pi_cache=None):\n    \"\"\"Evaluate one intertwiner's section basis functions at quadrature nodes.\n\n    For intertwiner A of shape (d_rho, n+1), the section basis functions are:\n        f_{A,j}(x) = A . pi_n_unitary(x) . e_j    for j = 0, ..., n\n\n    giving a d_rho-valued function for each j.\n\n    Parameters\n    ----------\n    intertwiner : ndarray, shape (d_rho, n+1)\n        The intertwiner matrix A.\n    n : int\n        Representation level.\n    nodes : ndarray, shape (N_nodes, 4)\n        Quadrature nodes on S^3.\n    pi_cache : ndarray, shape (N_nodes, n+1, n+1) or None\n        Precomputed pi_n_unitary values. If None, they are computed here.\n\n    Returns\n    -------\n    values : ndarray, shape (N_nodes, d_rho, n+1)\n        values[i, a, j] = sum_b A[a,b] * pi_n_unitary(nodes[i])[b,j].\n    \"\"\"\n    if pi_cache is None:\n        pi_cache = eval_pi_n_unitary_at_nodes(n, nodes)\n\n    # intertwiner is (d_rho, dim_n), pi_cache is (N_nodes, dim_n, dim_n)\n    # result[i] = A @ pi_cache[i], shape (d_rho, dim_n)\n    # Use einsum: result[i, a, j] = sum_b A[a,b] * pi_cache[i,b,j]\n    values = np.einsum('ab,ibj->iaj', intertwiner, pi_cache)\n    return values\n\n\n# ---------------------------------------------------------------------------\n# Direct synthesis (coefficients -> field values at nodes)\n# ---------------------------------------------------------------------------\n\ndef synthesis(coefficients, basis_obj, nodes, rho=None):\n    \"\"\"Evaluate an equivariant field at quadrature nodes from Galerkin coefficients.\n\n    The field is:\n        psi(x) = sum_{n} sum_{i=0}^{m_n-1} sum_{j=0}^{n}\n                     c_{n,i,j} * A_{n,i} . pi_n(x) . e_j\n\n    where A_{n,i} are the orthonormalized intertwiners from basis_obj.\n\n    Parameters\n    ----------\n    coefficients : ndarray, shape (N_total,) complex\n        Galerkin coefficients in level-major, intertwiner-index, then j order.\n        N_total = sum over active levels of mult(rho, n) * (n+1).\n    basis_obj : dict\n        level n -> ndarray of shape (mult, d_rho, n+1), the orthonormalized\n        intertwiners. Produced by sections.build_basis_object().\n    nodes : ndarray, shape (N_nodes, 4)\n        Quadrature nodes on S^3.\n    rho : str or None\n        Sector name (for extracting d_rho). If None, inferred from basis_obj.\n\n    Returns\n    -------\n    field : ndarray, shape (N_nodes, d_rho), dtype complex\n        The field evaluated at each node.\n    \"\"\"\n    # Determine d_rho from the first available level\n    levels = sorted(basis_obj.keys())\n    if len(levels) == 0:\n        raise ValueError(\"empty basis_obj\")\n    d_rho = basis_obj[levels[0]].shape[1]\n\n    n_nodes = len(nodes)\n    field = np.zeros((n_nodes, d_rho), dtype=complex)\n\n    # Walk through coefficients level by level\n    offset = 0\n    for n in levels:\n        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n        m = A_all.shape[0]\n        dim_n = n + 1\n        block_size = m * dim_n\n\n        # Extract this level's coefficients: shape (m, dim_n)\n        c_block = coefficients[offset:offset + block_size].reshape(m, dim_n)\n        offset += block_size\n\n        # Compute pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n\n        # For each intertwiner i and column j:\n        #   contribution = c_{n,i,j} * A_{n,i} @ pi_n(x) @ e_j\n        # Vectorized: for intertwiner i,\n        #   A_i @ pi_vals[node] has shape (d_rho, dim_n)\n        #   sum over j of c[i,j] * (A_i @ pi_vals)[node, :, j]\n        #     = A_i @ pi_vals[node] @ c[i, :]\n\n        # section_vals[i, node, :] = A_i @ pi_vals[node] @ c[i, :]\n        for i in range(m):\n            # A_all[i] @ pi_vals: shape (N_nodes, d_rho, dim_n)\n            Apn = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n            # Contract with c_block[i]: (N_nodes, d_rho)\n            field += np.einsum('naj,j->na', Apn, c_block[i])\n\n    return field\n\n\n# ---------------------------------------------------------------------------\n# Direct analysis (field values at nodes -> coefficients)\n# ---------------------------------------------------------------------------\n\ndef analysis(field_values, basis_obj, nodes, weights):\n    \"\"\"Compute Galerkin coefficients from field values at quadrature nodes.\n\n    This is the quadrature-weighted adjoint of synthesis:\n        c_{n,i,j} = sum_nodes w_node * f_{n,i,j}(x_node)^H . psi(x_node)\n\n    where f_{n,i,j}(x) = A_{n,i} . pi_n(x) . e_j is the section basis function.\n\n    For orthonormal sections and an exact-enough rule, analysis(synthesis(c)) = c.\n\n    Parameters\n    ----------\n    field_values : ndarray, shape (N_nodes, d_rho), dtype complex\n        The field evaluated at each node.\n    basis_obj : dict\n        level n -> ndarray of shape (mult, d_rho, n+1).\n    nodes : ndarray, shape (N_nodes, 4)\n        Quadrature nodes on S^3.\n    weights : ndarray, shape (N_nodes,)\n        Quadrature weights (summing to 1).\n\n    Returns\n    -------\n    coefficients : ndarray, shape (N_total,), dtype complex\n        Galerkin coefficients in level-major order.\n    \"\"\"\n    levels = sorted(basis_obj.keys())\n    if len(levels) == 0:\n        raise ValueError(\"empty basis_obj\")\n\n    # Weighted field values: shape (N_nodes, d_rho)\n    weighted_field = weights[:, None] * field_values\n\n    coeffs_list = []\n\n    for n in levels:\n        A_all = basis_obj[n]           # shape (mult, d_rho, n+1)\n        m = A_all.shape[0]\n        dim_n = n + 1\n\n        # pi_n at all nodes: shape (N_nodes, dim_n, dim_n)\n        pi_vals = eval_pi_n_unitary_at_nodes(n, nodes)\n\n        c_block = np.zeros((m, dim_n), dtype=complex)\n\n        for i in range(m):\n            # Section basis values: f_{i,j}(x)[a] = sum_b A[a,b] pi[b,j]\n            # f_vals shape: (N_nodes, d_rho, dim_n)\n            f_vals = np.einsum('ab,nbj->naj', A_all[i], pi_vals)\n\n            # Inner product: c[i,j] = sum_node sum_a w[node] * f[node,a,j]^* * psi[node,a]\n            # = sum_node sum_a f_vals[node,a,j]^* * weighted_field[node,a]\n            c_block[i] = np.einsum('naj,na->j', f_vals.conj(), weighted_field)\n\n        # No normalization factor needed: the Lowdin-orthonormalized\n        # intertwiners satisfy tr(A_i^H A_k) / (n+1) = delta_{ik},\n        # which combined with Schur orthogonality (integral of\n        # pi[b,j]^* pi[c,l] = delta_{bc} delta_{jl} / (n+1)) gives\n        # orthonormal sections: <f_{i,j}, f_{k,l}> = delta_{ik} delta_{jl}.\n\n        coeffs_list.append(c_block.ravel())\n\n    return np.concatenate(coeffs_list)\n","numLines":341,"startLine":1,"totalLines":341}},"sourceToolAssistantUUID":"0966e574-4e30-4c24-9a2d-eec231a2cc51","userType":"external","entrypoint":"cli","cwd":"/Users/blake/Desktop/MIT/OpenWave/M8.5C2_BUILD","sessionId":"df404d7f-30da-41ec-8c3e-12ef3f92c53b","version":"2.1.251","gitBranch":"HEAD","slug":"binary-orbiting-pelican"}
